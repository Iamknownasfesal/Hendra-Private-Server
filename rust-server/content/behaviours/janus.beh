enemy "md dwGenerator" {
    state nokillswag {
        conditional_effect(invincible)
    }
}

enemy "md LightKey" {
    state Bullet15 {
        shoot(10, count: 15, projectile: 0, cooldown: 800)
        on entity_exists("md dwGenerator", 9999) -> MoveToJanus
    }
    state MoveToJanus {
        move_to2(0, 6, speed: 0.5, is_map_position: false, once: true)
        on timed(2000) -> Bullet8
    }
    state Bullet8 {
        shoot(10, count: 8, projectile: 1)
        heal_entity(20, "md Janus the Doorwarden", 2000, cooldown: 9999)
        on entities_not_exists(9999, "md dwGenerator") -> MoveAwayJanus
    }
    state MoveAwayJanus {
        move_to2(0, -6, speed: 0.5, is_map_position: false, once: true)
        on timed(2000) -> Bullet15
    }
}

