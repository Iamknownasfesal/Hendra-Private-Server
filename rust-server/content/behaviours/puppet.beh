enemy "Puppet Bomb" {
    transform_on_death("Sorc Bomb Thrower", 1, 1, 1)
    state BOUTTOEXPLODE {
        on timed(2750) -> boom
    }
    state boom {
        shoot(8.4, count: 1, fixed_angle: 0, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 90, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 180, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 270, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 45, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 135, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 235, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 315, projectile: 0, cooldown: 1000)
        suicide()
    }
}

