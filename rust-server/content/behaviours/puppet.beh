enemy "Warrior Puppet" {
    state jugg {
        conditional_effect(armored)
        wander(0.6)
        on timed(4700) -> berserk
    }
    state berserk {
        shoot(8.4, count: 1, projectile: 0, cooldown: 1)
        on timed(4700) -> jugg
    }
}

enemy "Rogue Puppet" {
    state jugg {
        set_alt_texture(1)
        wander(0.6)
        on timed(3000) -> berserk
    }
    state berserk {
        wander(0.4)
        set_alt_texture(0)
        shoot(8.4, count: 1, projectile: 0, cooldown: 1500)
        on timed(3000) -> jugg
    }
}

enemy "Trickster Puppet" {
    state wait {
        wander(0.3)
        on player_within(6) -> start
    }
    state start {
        reproduce("Trickster Decoys", density_max: 1, density_radius: 1, cooldown: 5250)
        prioritize() {
            wander(0.6)
            stay_back(0.3, 3)
        }
        shoot(8.4, count: 1, projectile: 0, cooldown: 1300)
    }
}

