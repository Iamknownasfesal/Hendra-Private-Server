enemy "vlntns Loot Balloon Bella" {
    drop_portal_on_death("Garden of Chaos Portal", 0.1)
    state Idle {
        conditional_effect(invulnerable)
        on timed(5000) -> UnsetEffect
    }
    state UnsetEffect {
    }
    loot {
        threshold
    }
}

