enemy "NM Blue Dragon God" {
    transform_on_death("lod Blue Loot Balloon", 1, 1, 1)
    on hp_below(0.12) -> DyingPhase
    state idle {
        set_alt_texture(1)
        conditional_effect(invincible)
        on entity_not_exists("NM Blue Dragon Soul", 9999) -> Awakening
    }
    state Awakening {
        conditional_effect(invincible)
        flash(16777215, 2, 3)
        on timed(4768) -> mychildren
    }
    state mychildren {
        set_alt_texture(0)
        taunt(0.8, "My children will feast on your soul!", "Look out! My minions will help me!", "If I don't kill you, my minions will!")
        spawn("NM Blue Dragon Minion", 2, 1, cooldown: 5000)
        prioritize() {
            follow(0.75, 8, 1)
            stay_back(0.2, 4)
        }
        shoot(10, count: 9, shoot_angle: 26, projectile: 3, predictive: 1.6, cooldown: 500)
        shoot(10, count: 5, shoot_angle: 20, projectile: 1, cooldown: 2000)
        shoot(10, count: 3, projectile: 2, cooldown: 1570)
        on timed(8950) -> tastymostrels
    }
    state tastymostrels {
        taunt(0.8, "You're a nasty little pest!", "You look like a tasty morsel! *SCREEEEEECH*")
        prioritize() {
            stay_back(0.3, 3)
            wander(0.12)
        }
        shoot(10, count: 16, projectile: 3, predictive: 1.5, cooldown: 1050)
        shoot(10, count: 5, shoot_angle: 20, projectile: 1, predictive: 0.5, cooldown: 1475)
        on timed(7450) -> tastymostrels2
    }
    state tastymostrels2 {
        taunt(0.8, "You can not handle the full power of my onslaught")
        prioritize() {
            follow(0.885, 8, 1)
            stay_back(0.3, 3)
        }
        shoot(10, count: 16, projectile: 3, predictive: 2.25, cooldown: 2550)
        shoot(10, count: 8, shoot_angle: 20, projectile: 3, predictive: 2.25, cooldown: 1250)
        shoot(10, count: 5, shoot_angle: 20, projectile: 1, predictive: 0.5, cooldown: 1600)
        shoot(10, count: 7, shoot_angle: 18, projectile: 2, cooldown: 2000, cooldown_offset: 2000)
        on timed(9000) -> returntospawn
    }
    state returntospawn {
        return_to_spawn(speed: 0.5)
        shoot(10, count: 16, projectile: 3, cooldown: 1000)
        on timed(2000) -> standandrek
    }
    state standandrek {
        taunt(1, "You look tasty! I'm going to eat you!", "Yum! I can already taste you!")
        shoot(10, count: 21, projectile: 3, cooldown: 2000)
        shoot(10, count: 5, shoot_angle: 26, projectile: 2, predictive: 0.5, cooldown: 500)
        shoot(10, count: 3, shoot_angle: 26, projectile: 3, predictive: 4.5, cooldown: 1500)
        on timed(8500) -> mychildren
    }
    conditional_effect(invincible)
    state DyingPhase {
        remove_entity(9999, "NM Blue Dragon Minion")
        return_to_spawn(speed: 0.3)
        flash(16777215, 2, 3)
        taunt(1, "I have underestimated your power!", "WHY! YOU WERE GOING TO BE SO DELICIOUS IN MY STOMACH!")
        on timed(4750) -> restinwater
    }
    state restinwater {
        suicide()
    }
}

