}

enemy "NM Red Dragon Soul" {
    set_no_x_p()
    conditional_effect(invincible)
    state idle {
        orbit(0.2, 2.5, 20, "NM Altar of Draconis")
    }
    state goToRedDragon {
        order(670, "NM Green Dragon Soul", "redinactive")
        order(670, "NM Black Dragon Soul", "redinactive")
        order(670, "NM Red Dragon Soul", "redinactive")
        order(670, "NM Blue Dragon Soul", "redinactive")
        remove_tile_object("Iron Brick", 99)
        orbit(0.45, 2.5, 9999, "NM Red Dragon God")
        suicide()
    }
    state rip {
        suicide()
    }
    state greeninactive {
        on entities_not_exists(9999, "NM Green Dragon God") -> idle
        orbit(0.2, 2.5, 20, "NM Altar of Draconis")
    }
    state redinactive {
        on entities_not_exists(9999, "NM Red Dragon God") -> rip
        orbit(0.2, 2.5, 20, "NM Altar of Draconis")
    }
    state blackinactive {
        on entities_not_exists(9999, "NM Black Dragon God") -> idle
        orbit(0.2, 2.5, 20, "NM Altar of Draconis")
    }
    state blueinactive {
        on entities_not_exists(9999, "NM Blue Dragon God") -> idle
        orbit(0.2, 2.5, 20, "NM Altar of Draconis")
    }
}

