            shoot(10, count: 2, shoot_angle: 36, projectile: 0, cooldown: 3000)
            shoot(10, count: 8, shoot_angle: 60, projectile: 2, cooldown: 2000)
            shoot(10, count: 2, projectile: 1, cooldown: 1500)
            shoot(10, count: 2, projectile: 3, predictive: 2, cooldown: 1700)
            grenade(5, 100, range: 6, cooldown: 2000)
            on timed(3250, "1") -> s1
        }
    }
    state returntospawn {
        return_to_spawn(speed: 0.5)
        shoot(10, count: 4, shoot_angle: 36, projectile: 3, cooldown: 3000)
        on timed(2000) -> invisibleattack
    }
    state invisibleattack {
        shoot(10, count: 8, shoot_angle: 28, projectile: 6, cooldown: 2600)
        set_alt_texture(2)
        wander(0.2)
        remove_entity(9999, "NM Black Dragon Shadow")
        conditional_effect(invincible)
        shoot(10, count: 2, shoot_angle: 36, projectile: 0, cooldown: 3000)
        shoot(10, count: 8, shoot_angle: 60, projectile: 2, cooldown: 2000)
        shoot(10, count: 2, projectile: 1, cooldown: 1500)
        shoot(10, count: 2, projectile: 3, predictive: 2, cooldown: 1700)
        on timed(7000) -> backandforth
    }
    conditional_effect(invincible)
    state DyingPhase {
        remove_entity(9999, "NM Black Dragon Shadow")
        remove_entity(9999, "NM Black Dragon Minion")
        return_to_spawn(speed: 0.3)
        flash(16777215, 2, 3)
        taunt(1, "Until we meet again...sub-creature...")
        on timed(4750) -> restindark
    }
    state restindark {
        suicide()
    }
}

enemy "NM Red Dragon God" {
    transform_on_death("lod Red Loot Balloon", 1, 1, 1)
    on hp_below(0.12) -> DyingPhase
    state idle {
        set_alt_texture(1)
        conditional_effect(invincible)
        on entity_not_exists("NM Red Dragon Soul", 9999) -> Awakening
    }
    state Awakening {
        conditional_effect(invincible)
        flash(16777215, 2, 3)
        on timed(4768) -> mychildren
    }
    state mychildren {
        set_alt_texture(0)
        on timed(3000) -> shootbigballs
    }
    state shootbigballs {
        reproduce("NM Red Dragon Minion", 5, 5, cooldown: 4750)
        return_to_spawn(speed: 0.6)
        shoot(10, count: 9, projectile: 0, cooldown: 2500)
        shoot(10, count: 12, projectile: 1, cooldown: 5000)
        conditional_effect(armored)
        on timed(6000) -> chase
    }
    state chase {
        taunt(1, "Eat these delicious flames and balls!", "Fire is my favorite!")
        prioritize() {
            follow(0.885, 8, 1)
            stay_back(0.3, 3)
        }
        shoot(10, count: 12, projectile: 3, predictive: 2.25, cooldown: 2550)
        shoot(10, count: 4, shoot_angle: 8, projectile: 0, cooldown: 3250)
        on timed(9000) -> breath
    }
    state breath {
        taunt(1, "I shall breathe straight fire onto you!", "Check out this mixtape!")
        swirl(1.1, 5, 8, false)
        shoot(10, count: 3, shoot_angle: 3, projectile: 0, cooldown: 1)
        on timed(7500) -> breatah
    }
    state breatah {
        taunt(1, "You can't stop the FLAMING FIRESZ!")
        wander(1)
        shoot(10, count: 18, shoot_angle: 3, projectile: 1, cooldown: 1500)
        on timed(6000) -> shootbigballs
    }
    conditional_effect(invincible)
    state DyingPhase {
        remove_entity(9999, "NM Red Dragon Minion")
        return_to_spawn(speed: 0.3)
        flash(16777215, 2, 3)
        taunt(1, "The flame has been put out! Darn.")
        on timed(4750) -> restinwater
    }
    state restinwater {
        suicide()
    }
}

enemy "lod Ivory Wyvern" {
    realm_portal_drop()
    on hp_below(0.11) -> ripwyvern
    realm_portal_drop()
    state default {
        conditional_effect(invincible)
        on player_within(7) -> talk1
    }
    conditional_effect(invincible)
    state talk1 {
        taunt(1, "Thank you adventurer, you have freed the souls of the four dragons so that I may consume their powers.")
        on timed(4500) -> talk2
    }
    state talk2 {
        taunt(1, "I owe you much, but I cannot let you leave. These walls will make a fine graveyard for your bones.")
        on timed(4500) -> talk3
    }
    state talk3 {
        taunt(1, "Behold the glory of my true powers!", "Time to munch on you like potato chips.")
        on timed(2000) -> Mirrors
    }
    state Mirrors {
        back_and_forth(0.35, 10)
        toss_object("lod Mirror Wyvern1", 10, angle: 180, cooldown: 99999)
        toss_object("lod Mirror Wyvern1", 6, angle: 180, cooldown: 99999)
        toss_object("lod Mirror Wyvern1", 10, angle: 0, cooldown: 99999)
        toss_object("lod Mirror Wyvern1", 5, angle: 0, cooldown: 99999)
        shoot(8.4, count: 7, shoot_angle: 16, projectile: 0, cooldown: 1)
        on damage_taken(14000) -> movetothemiddle2
    }
    state movetothemiddle2 {
        conditional_effect(invulnerable)
        move_to(speed: 0.5, x: 13, y: 5)
        taunt("Look at these beautiful flames!")
        on timed(2000) -> Flames
    }
    state Flames {
        conditional_effect(invulnerable)
        remove_entity(9999, "lod Mirror Wyvern1")
        toss_object("lod Black Soul Flame", 10, angle: 180, cooldown: 99999)
        toss_object("lod Red Soul Flame", 6, angle: 180, cooldown: 99999)
        toss_object("lod Green Soul Flame", 10, angle: 0, cooldown: 99999)
        toss_object("lod Blue Soul Flame", 5, angle: 0, cooldown: 99999)
        on timed(2000) -> checkforflames
    }
    conditional_effect(invincible)
    state checkforflames {
        on entities_not_exists(9999, "lod Black Soul Flame", "lod Blue Soul Flame", "lod Red Soul Flame", "lod Green Soul Flame") -> movetothemiddle
    }
    state movetothemiddle {
        move_to(speed: 0.5, x: 13, y: 16)
        taunt("You darith try to beatith me ith, preparith to dieith in theith Ivoryith Wyvernith where youith will cryith everyith timeith.")
        on timed(4000) -> alldshots
    }
    state alldshots {
        conditional_effect(armored)
        heal_self(cooldown: 1750, amount: 1000)
        shoot(8.4, count: 10, shoot_angle: 14, projectile: 0, cooldown: 3500)
        shoot(8.4, count: 8, shoot_angle: 10, fixed_angle: 45, projectile: 1, cooldown: 2000)
        shoot(8.4, count: 8, shoot_angle: 10, fixed_angle: 135, projectile: 2, cooldown: 2000)
        shoot(8.4, count: 8, shoot_angle: 10, fixed_angle: 225, projectile: 3, cooldown: 2000)
        shoot(8.4, count: 8, shoot_angle: 10, fixed_angle: 315, projectile: 4, cooldown: 2000)
        on timed(8250) -> whiteorbs
    }
    state whiteorbs {
        toss_object("lod White Dragon Orb", 10, angle: 45, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 135, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 225, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 315, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 90, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 0, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 180, cooldown: 99999)
        toss_object("lod White Dragon Orb", 10, angle: 270, cooldown: 99999)
        on timed(2000) -> chaseandfight
    }
    state chaseandfight {
        follow(0.2, 8, 1)
        shoot(8.4, count: 12, shoot_angle: 14, projectile: 0, cooldown: 6000)
        shoot(8.4, count: 24, projectile: 0, cooldown: 10000)
        shoot(8.4, count: 1, projectile: 0, cooldown: 4812)
        shoot(8.4, count: 1, projectile: 1, cooldown: 6812)
        shoot(8.4, count: 1, projectile: 2, cooldown: 8912)
        shoot(8.4, count: 1, projectile: 3, cooldown: 7212)
        shoot(8.4, count: 1, projectile: 4, cooldown: 9812)
    }
    conditional_effect(invincible)
    state ripwyvern {
        remove_entity(9999, "lod White Dragon Orb")
        move_to(speed: 0.5, x: 13, y: 16)
        taunt("You may have beaten me this time, but I will find a way to leave this place! And on that day, you will suffer greatly!")
        on timed(3000) -> rip4evs
    }
    state rip4evs {
        suicide()
    }
    loot {
        threshold(0.05) {  }
        threshold(0.15) { item("Potion of Dexterity", 0.3) item("Potion of Wisdom", 0.3) tier(12, weapon, 0.065) tier(12, weapon, 0.055) tier(6, ability, 0.065) tier(5, ability, 0.0685) tier(13, armor, 0.0525) item("Midnight Star", 0.04) item("Ivory Ring", 0.055) item("Large Ivory Dragon Scale Cloth", 0.045) item("Small Ivory Dragon Scale Cloth", 0.047) }
    }
}

