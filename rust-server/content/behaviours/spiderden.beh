enemy "Green Den Spider Hatchling" {
    state idle {
        wander(0)
        follow(0.8, 0.8, 0)
        shoot(10, 1, 0, default_angle: 0, angle_offset: 0, projectile: 0, predictive: 1, cooldown: 1000, cooldown_offset: 0)
