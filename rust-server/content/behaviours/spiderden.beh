enemy "Spider Egg Sac" {
    transform_on_death("Green Den Spider Hatchling", 2, 7)
    state idle {
        on player_within(0.5) -> suicide
    }
    state suicide {
        suicide()
    }
}

enemy "Red Spotted Den Spider" {
    state idle {
        wander(0)
        follow(1, 0.8, 0)
        shoot(10, 1, 0, default_angle: 0, angle_offset: 0, projectile: 0, predictive: 1, cooldown: 500, cooldown_offset: 0)
    }
    loot {
