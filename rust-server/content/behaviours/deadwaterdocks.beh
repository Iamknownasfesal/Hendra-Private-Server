enemy "Deadwater Docks Parrot" {
    on entity_not_exists("Jon Bilgewater the Pirate King", 90000) -> rip
    state CircleOrWander {
        prioritize() {
            orbit(0.55, 2, 5, "Parrot Cage")
            wander(0.12)
        }
    }
    state Orbit_HealJon {
        orbit(0.55, 2, 20, "Jon Bilgewater the Pirate King")
        heal_self(cooldown: 2000, amount: 100)
    }
    state rip {
        suicide()
    }
}

enemy "Parrot Cage" {
    conditional_effect(invincible)
    state NoSpawn {
    }
    state SpawnParrots {
        reproduce("Deadwater Docks Parrot", density_radius: 5, density_max: 5, cooldown: 2500)
    }
}

enemy "Bottled Evil Water" {
    state water {
        conditional_effect(invincible)
        on timed(2000) -> drop
    }
    state drop {
        apply_setpiece("BottledEvil")
        suicide()
    }
}

enemy "Deadwater Docks Lieutenant" {
    follow(1, 8, 1)
    shoot(8, 1, 10, cooldown: 1000)
    toss_object("Bottled Evil Water", cooldown: 6750)
    loot {
        item("Magic Potion", 0.1)
        item("Health Potion", 0.1)
    }
}

enemy "Deadwater Docks Veteran" {
    follow(0.8, 8, 1)
    shoot(8, 1, 10, cooldown: 500)
    loot {
        tier(10, weapon, 0.05)
        item("Magic Potion", 0.1)
        item("Health Potion", 0.1)
    }
}

