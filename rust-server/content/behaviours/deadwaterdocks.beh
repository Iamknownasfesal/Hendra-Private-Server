enemy "Jon Bilgewater the Pirate King" {
    realm_portal_drop()
    state default {
        on player_within(8) -> coinphase
    }
    order(90, "Parrot Cage", "SpawnParrots")
    on damage_taken(32500) -> gotoSpawn
    state coinphase {
        wander(0.11)
        shoot(10, count: 1, projectile: 0, cooldown: 2000)
        on timed(4500) -> cannonballs
    }
    state cannonballs {
        follow(0.32, 8, cooldown: 1000)
        shoot(10, count: 7, shoot_angle: 30, projectile: 1, cooldown: 2150)
        on timed(5000) -> coinphase
    }
    state gotoSpawn {
        return_to_spawn(speed: 0.52)
        conditional_effect(invincible)
        conditional_effect(stun_immune)
        on timed(3500) -> blastcannonballs
    }
    state blastcannonballs {
        conditional_effect(stun_immune)
        order(90, "Deadwater Docks Parrot", "CircleOrWander")
        shoot(10, count: 7, shoot_angle: 30, projectile: 1, cooldown: 1750)
        on timed(6000) -> parrotcircle
    }
    state parrotcircle {
        conditional_effect(stun_immune)
        order(90, "Deadwater Docks Parrot", "Orbit&HealJon")
        on timed(6000) -> blastcannonballs
    }
    loot {
        threshold(0.05) {  }
        threshold(0.025) { item("Potion of Speed", 1) item("Potion of Dexterity", 1) tier(12, weapon, 0.1) tier(5, ability, 0.1) tier(11, armor, 0.05) tier(11, weapon, 0.05) tier(4, ring, 0.025) item("Pirate King's Cutlass", 0.03) }
    }
}

