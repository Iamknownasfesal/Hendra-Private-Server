enemy "Arena Mushroom" {
    state Mush1 {
        on hp_below(0.75) -> Mush2
    }
    state Mush2 {
        set_alt_texture(1)
        on hp_below(0.5) -> Mush3
    }
    state Mush3 {
        set_alt_texture(2)
        on hp_below(0.25) -> die
    }
    state die {
        shoot(8.4, count: 1, fixed_angle: 0, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 90, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 180, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 270, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 45, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 135, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 235, projectile: 0, cooldown: 1000)
        shoot(8.4, count: 1, fixed_angle: 315, projectile: 0, cooldown: 1000)
        suicide()
    }
}

enemy "Troll 3" {
    state trololo {
        on player_within(8) -> move
        conditional_effect(invulnerable)
    }
    state move {
        conditional_effect(invulnerable)
        move_to(speed: 1, x: 22, y: 18)
        on timed(500) -> trolled
    }
    state trolled {
        wander(0.4)
        toss_object("Arena Mushroom", 3, cooldown: 2000)
        shoot(10, count: 6, projectile: 0, cooldown: 1250)
        shoot(10, count: 1, projectile: 1, cooldown: 1000)
        on damage_taken(5000) -> skilitins
    }
    state skilitins {
        shoot(10, predictive: 1, cooldown: 1750)
        toss_object("Arena Skeleton", 3, cooldown: 1000)
        on timed(4750) -> skelcheck
    }
    state skelcheck {
        conditional_effect(invulnerable)
        shoot(10, predictive: 1, cooldown: 1750)
        toss_object("Arena Skeleton", 3, cooldown: 3000)
        on entities_not_exists(9999, "Arena Skeleton") -> trolled
    }
    loot {
        threshold(0.025) { tier(8, weapon, 0.1) tier(5, ability, 0.1) tier(9, armor, 0.1) tier(3, ring, 0.05) tier(10, armor, 0.05) tier(10, weapon, 0.05) tier(4, ring, 0.025) item("Potion of Speed", 1) item("Potion of Wisdom", 0.5) }
    }
}

