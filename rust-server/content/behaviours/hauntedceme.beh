enemy "Area 1 Controller" {
    conditional_effect(invincible)
    state Greeting {
        on player_within(2) -> talk1
    }
    state talk1 {
        set_alt_texture(2)
        taunt(1, "Welcome to my domain. I challenge you, warrior, to defeat my undead hordes and claim your prize...")
        on timed(5000) -> talk3
    }
    state talk3 {
        set_alt_texture(1)
        taunt(1, "Prepare yourself, Say Ready when you wish the battle to begin!")
    }
    state s1 {
        set_alt_texture(0)
        order(9999, "Arena East Gate Spawner", "arena1wave1")
        order(9999, "Arena West Gate Spawner", "arena1wave1")
        order(9999, "Arena South Gate Spawner", "arena1wave1")
        order(9999, "Arena North Gate Spawner", "arena1wave1")
        on timed(2750, "2") -> s2
    }
    state s2 {
        set_alt_texture(0)
        on entities_not_exists(9999, "3", "Arena Skeleton", "Troll 1", "Troll 2") -> s3
    }
    state s3 {
        set_alt_texture(1)
        taunt(1, "Only seconds until the next wave.")
        on timed(5000, "4") -> s4
    }
    state s4 {
        set_alt_texture(0)
        order(9999, "Arena East Gate Spawner", "arena1wave2")
        order(9999, "Arena West Gate Spawner", "arena1wave2")
        order(9999, "Arena South Gate Spawner", "arena1wave2")
        order(9999, "Arena North Gate Spawner", "arena1wave2")
        on timed(2750, "5") -> s5
    }
    state s5 {
        set_alt_texture(0)
        on entities_not_exists(9999, "6", "Arena Skeleton", "Troll 1", "Troll 2") -> s6
    }
    state s6 {
        set_alt_texture(1)
        taunt(1, "Only seconds until the next wave.")
        on timed(5000, "7") -> s7
    }
    state s7 {
        set_alt_texture(0)
        order(9999, "Arena East Gate Spawner", "arena1wave3")
        order(9999, "Arena West Gate Spawner", "arena1wave3")
        order(9999, "Arena South Gate Spawner", "arena1wave3")
        order(9999, "Arena North Gate Spawner", "arena1wave3")
        on timed(2750, "8") -> s8
    }
    state s8 {
        set_alt_texture(0)
        on entities_not_exists(9999, "9", "Arena Skeleton", "Troll 1", "Troll 2") -> s9
    }
    state s9 {
        set_alt_texture(1)
        taunt(1, "Only seconds until the next wave.")
        on timed(5000, "10") -> s10
    }
    state s10 {
        set_alt_texture(0)
        order(9999, "Arena East Gate Spawner", "arena1wave4")
        order(9999, "Arena West Gate Spawner", "arena1wave4")
        order(9999, "Arena South Gate Spawner", "arena1wave4")
        order(9999, "Arena North Gate Spawner", "arena1wave4")
        on timed(2750, "11") -> s11
    }
    state s11 {
        set_alt_texture(0)
        on entities_not_exists(9999, "12", "Arena Skeleton", "Troll 1", "Troll 2") -> s12
    }
    state s12 {
        set_alt_texture(1)
        taunt(1, "Only seconds until the next wave.")
        on timed(5000, "13") -> s13
    }
    state s13 {
        set_alt_texture(0)
        order(9999, "Arena North Gate Spawner", "arena1boss")
        on timed(2750, "14") -> s14
    }
    state s14 {
        set_alt_texture(0)
        on entities_not_exists(9999, "Troll 3") -> portal
