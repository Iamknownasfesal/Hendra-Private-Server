enemy "Arena Ghost Bride" {
    state trololo {
        on player_within(8) -> fightTillFate
        conditional_effect(invulnerable)
    }
    state moveFate {
        set_alt_texture(0)
        move_to(speed: 1, x: 21, y: 11)
        on timed(500) -> goByeFate
    }
    state moveGlory {
        set_alt_texture(0)
        move_to(speed: 1, x: 27, y: 11)
        on timed(500) -> goByeGlory
    }
    state fightTillFate {
        back_and_forth(1, 2)
        set_alt_texture(0)
        shoot(10, count: 1, projectile: 0, cooldown: 1100)
        shoot(10, count: 8, projectile: 1, cooldown: 1000)
        on timed(4000) -> moveFate
    }
    state fightTillGlory {
        back_and_forth(1, 2)
        set_alt_texture(0)
        shoot(10, count: 1, projectile: 0, cooldown: 1100)
        shoot(10, count: 8, projectile: 1, cooldown: 1000)
        on timed(4000) -> moveGlory
    }
    state goByeFate {
        spawn("FateT", initial_spawn: 1, max_children: 1, cooldown: 99999)
        conditional_effect(invincible)
        set_alt_texture(1)
        on entities_not_exists(9999, "Arena Statue Left") -> fightTillGlory
    }
    state goByeGlory {
        set_alt_texture(1)
        spawn("GloryT", initial_spawn: 1, max_children: 1, cooldown: 99999)
        conditional_effect(invincible)
        on entities_not_exists(9999, "Arena Statue Right") -> justfight
    }
    state justfight {
        wander(1)
        shoot(10, count: 6, shoot_angle: 5, projectile: 0, cooldown: 1100)
        shoot(10, count: 2, shoot_angle: 5, projectile: 1, cooldown: 1000)
    }
    loot {
        threshold(0.025) { tier(8, weapon, 0.1) tier(5, ability, 0.1) tier(9, armor, 0.1) tier(3, ring, 0.05) tier(10, armor, 0.05) tier(10, weapon, 0.05) tier(4, ring, 0.025) item("Potion of Speed", 1) item("Amulet of Resurrection", 0.0002) item("Potion of Wisdom", 0.5) }
    }
}

