enemy "Ghost Lanturn On" {
    state idle {
        conditional_effect(invulnerable)
        on timed(5000) -> deactivate
    }
    state deactivate {
        conditional_effect(invulnerable)
        on entity_not_exists("Ghost Lanturn Off", 10) -> shoot
        on timed(10000) -> gone
    }
    state shoot {
        shoot(10, 6, cooldown: 9000001, cooldown_offset: 100)
        on timed(1000) -> gone
    }
    state gone {
        conditional_effect(invulnerable)
        transform("Ghost Lanturn Off")
    }
}

enemy "Lil' Ghost Pirate" {
    change_size(30, 120)
    shoot(10, count: 1, projectile: 0, cooldown: 2000)
    state Default {
        prioritize() {
            follow(0.6, 8, 1)
            wander(0.1)
        }
        on timed(2850) -> Default1
    }
    state Default1 {
        stay_back(0.2, 3)
        on timed(1850) -> Default
    }
}

