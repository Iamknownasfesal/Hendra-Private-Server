enemy "TestChicken Small" {
    state Orbit {
        wander(0.7)
        orbit(0.37, 4, 20, "TestChicken 2")
        shoot(10, 8, projectile: 2, cooldown: 2000)
    }
    state FollowAndAttack {
        wander(0.4)
        prioritize() {
            protect(1, "TestChicken 2", 100, 5, 5)
            follow(1.5, 8, 1)
        }
        state OrbitPlayer {
            orbit(0.8, 3, 10, "TestChicken 2")
            shoot(7, projectile: 0, count: 10, fixed_angle: 25, cooldown: 750)
        }
        state orbitattacking {
            orbit(0.7, 5.5, 10, "TestChicken 2")
            shoot(20, projectile: 3, count: 10, fixed_angle: 25, cooldown: 750)
        }
        state Despawn {
            suicide()
        }
    }
}

