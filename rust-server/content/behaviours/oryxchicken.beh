enemy "Test Egg" {
    state Idle {
        on hp_below(630000, "1") -> s1
    }
    state s1 {
        on hp_below(610000, "2") -> s2
        set_alt_texture(1)
    }
    state s2 {
        on hp_below(590000, "3") -> s3
        set_alt_texture(2)
    }
    state s3 {
        on hp_below(570000, "4") -> s4
        set_alt_texture(3)
    }
    state s4 {
        conditional_effect(invincible)
        set_alt_texture(4)
        on timed(250) -> Break
    }
    state Break {
        transform("TestChicken 2")
    }
}

