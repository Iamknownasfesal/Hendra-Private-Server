enemy "Turret Attack" {
    shoot(10, 2, 20, angle_offset: 0, projectile: 0, cooldown: 1000)
}

enemy "Mad Lab Open Wall" {
    transform_on_death("Invisible")
    conditional_effect(invincible)
    state destroy_all_tesla_coils {
        conditional_effect(invincible)
        on entity_not_exists("Tesla Coil", 1000, "Suicide :D") -> Suicide__D
    }
    state Suicide__D {
        suicide()
    }
}

enemy "Mad Scientist Summoner" {
    conditional_effect(invincible, true)
    state idle {
        on entities_not_exists(300, "Dr Terrible") -> Death
    }
    state Death {
        suicide()
    }
}

enemy "Dr Terrible Bubble" {
    state nothing_change {
        conditional_effect(invincible)
    }
    state Bubble_time {
        conditional_effect(invincible)
        on timed(1000, "Bubble time2") -> Bubble_time2
    }
    state Bubble_time2 {
        conditional_effect(invincible)
        on timed(1000, "Bubble time") -> Bubble_time
    }
}

enemy "Mad Gas Controller" {
    conditional_effect(invincible, true)
}

enemy "Monster Cage" {
    state no_spawn {
        conditional_effect(invincible)
    }
    state spawn {
        conditional_effect(invincible)
        spawn("Dr Terrible Rampage Cyborg", max_children: 1, initial_spawn: 0.5)
        spawn("Dr Terrible Mini Bot", max_children: 1, initial_spawn: 0.5)
        spawn("Dr Terrible Escaped Experiment", max_children: 1, initial_spawn: 0.5)
    }
}

