enemy "Escaped Experiment" {
    wander(0.5)
    shoot(10, 1, 0, default_angle: 0, angle_offset: 0, projectile: 0, predictive: 1, cooldown: 800, cooldown_offset: 0)
}

enemy "West Automated Defense Turret" {
    conditional_effect(invincible)
    shoot(32, fixed_angle: 0)
}

enemy "East Automated Defense Turret" {
    conditional_effect(invincible)
    shoot(32, fixed_angle: 180)
}

enemy "Crusher Abomination" {
    state s1_step {
        wander(0.5)
        shoot(10, 3, 20, angle_offset: 0, projectile: 0, cooldown: 1000)
        on hp_below(0.75, "2 step") -> s2_step
    }
    state s2_step {
        wander(0.5)
        change_size(11, 150)
        shoot(10, 2, 20, angle_offset: 0, projectile: 1, cooldown: 1000)
        on hp_below(0.5, "3 step") -> s3_step
    }
    state s3_step {
        wander(0.5)
        change_size(11, 175)
        shoot(10, 2, 20, angle_offset: 0, projectile: 2, cooldown: 1000)
        on hp_below(0.25, "4 step") -> s4_step
    }
    state s4_step {
        wander(0.5)
        change_size(11, 200)
        shoot(10, 2, 20, angle_offset: 0, projectile: 3, cooldown: 1000)
    }
}

enemy "Enforcer Bot 3000" {
    wander(0.5)
    shoot(10, 3, 20, angle_offset: 0, projectile: 0, cooldown: 1000)
    shoot(10, 4, 20, angle_offset: 0, projectile: 1, cooldown: 1000)
    transform_on_death("Mini Bot", 0, 3)
}

enemy "Green Potion" {
    state Idle {
        on timed(2000) -> explode
    }
    state explode {
        shoot(10, count: 6, projectile: 0, fixed_angle: 22.5)
        suicide()
    }
}

enemy "Red Gas Spawner UL" {
    on entity_not_exists("Dr Terrible", 50) -> OFF
    state OFF {
        conditional_effect(invincible)
    }
    state ON {
        conditional_effect(invincible)
        shoot(10, count: 20, projectile: 0, fixed_angle: 22.5)
    }
}

enemy "Red Gas Spawner UR" {
    on entity_not_exists("Dr Terrible", 50) -> OFF
    state OFF {
        conditional_effect(invincible)
    }
    state ON {
        conditional_effect(invincible)
        shoot(10, count: 20, projectile: 0, fixed_angle: 22.5)
    }
}

