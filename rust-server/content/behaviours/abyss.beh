enemy "Malphas Protector" {
    shoot(radius: 5, count: 3, shoot_angle: 5, projectile: 0, predictive: 0.45, cooldown: 1200)
    orbit(speed: 3.2, radius: 9, acquire_range: 20, target: "Archdemon Malphas", speed_variance: 0, radius_variance: 0, orbit_clockwise: true)
    loot {
        threshold(0.01) { item(item: "Magic Potion", probability: 0.06) item(item: "Health Potion", probability: 0.04) }
    }
}

enemy "Malphas Missile" {
    state Start {
        on timed(time: 50) -> Attacking
    }
    state Attacking {
        follow(speed: 1.1, acquire_range: 10, range: 0.2)
        on player_within(dist: 1.3) -> FlashBeforeExplode
        on timed(time: 5000) -> FlashBeforeExplode
    }
    state FlashBeforeExplode {
        flash(color: 16777215, flash_period: 0.1, flash_repeats: 6)
        on timed(time: 600) -> Explode
    }
    state Explode {
        shoot(radius: 0, count: 8, shoot_angle: 45, projectile: 0, fixed_angle: 0)
        suicide()
    }
}

enemy "Archdemon Malphas" {
    state start_the_fun {
        conditional_effect(invulnerable)
        on player_within(dist: 11, see_invis: true) -> he_is_never_alone
    }
    state he_is_never_alone {
        reproduce(children: "Malphas Protector", density_radius: 24, density_max: 3, cooldown: 1000)
        state Missile_Fire {
            prioritize() {
                stay_close_to_spawn(speed: 0.3, range: 5)
                follow(speed: 0.3, acquire_range: 8, range: 2)
            }
            shoot(radius: 8, count: 1, projectile: 0, angle_offset: 1, predictive: 0.15, cooldown: 900)
            reproduce(children: "Malphas Missile", density_radius: 24, density_max: 4, cooldown: 1800)
            state invulnerable1 {
                conditional_effect(invulnerable)
                on timed(time: 2000) -> vulnerable
            }
            state vulnerable {
                on timed(time: 4000) -> invulnerable2
            }
            state invulnerable2 {
                conditional_effect(invulnerable)
            }
            on timed(time: 9000) -> Pause1
        }
        state Pause1 {
            conditional_effect(invulnerable)
            prioritize() {
                stay_close_to_spawn(speed: 0.4, range: 5)
                wander(speed: 0.4)
            }
            on timed(time: 2500) -> Small_target
        }
        state Small_target {
            prioritize() {
                stay_close_to_spawn(speed: 0.8, range: 5)
                wander(speed: 0.8)
            }
            change_size(rate: -11, target: 30)
            shoot(radius: 0, count: 6, shoot_angle: 60, projectile: 1, fixed_angle: 0, cooldown: 1200)
            shoot(radius: 8, count: 1, angle_offset: 0.6, predictive: 0.15, cooldown: 900)
            on timed(time: 12000) -> Size_matters
        }
        state Size_matters {
            prioritize() {
                stay_close_to_spawn(speed: 0.2, range: 5)
                wander(speed: 0.2)
            }
            state Growbig {
                change_size(rate: 11, target: 140)
                conditional_effect(invulnerable)
                on timed(time: 1800) -> Shot_rotation1
            }
            state Shot_rotation1 {
                conditional_effect(invulnerable)
                shoot(radius: 8, count: 1, projectile: 2, predictive: 0.2, cooldown: 900)
                shoot(radius: 0, count: 3, shoot_angle: 120, projectile: 3, angle_offset: 0.7, default_angle: 0, cooldown: 700)
                on timed(time: 1400) -> Shot_rotation2
            }
            state Shot_rotation2 {
                shoot(radius: 8, count: 1, projectile: 2, predictive: 0.2, cooldown: 900)
                shoot(radius: 8, count: 1, projectile: 2, predictive: 0.25, cooldown: 2000)
                shoot(radius: 0, count: 3, shoot_angle: 120, projectile: 3, angle_offset: 0.7, default_angle: 40, cooldown: 700)
                on timed(time: 1400) -> Shot_rotation3
            }
            state Shot_rotation3 {
                conditional_effect(invulnerable)
                shoot(radius: 8, count: 1, projectile: 2, predictive: 0.2, cooldown: 900)
                shoot(radius: 0, count: 3, shoot_angle: 120, projectile: 3, angle_offset: 0.7, default_angle: 80, cooldown: 700)
                on timed(time: 1400) -> Shot_rotation1
            }
            on timed(time: 13000) -> Pause2
        }
        state Pause2 {
            change_size(rate: -11, target: 100)
            conditional_effect(invulnerable)
            prioritize() {
                stay_close_to_spawn(speed: 0.4, range: 5)
                wander(speed: 0.4)
            }
            on timed(time: 2500) -> Bring_on_the_flamers
        }
        state Bring_on_the_flamers {
            change_size(rate: 14, target: 100)
            conditional_effect(invulnerable)
            prioritize() {
                stay_close_to_spawn(speed: 0.4, range: 5)
                follow(speed: 0.4, acquire_range: 9, range: 2)
            }
            shoot(radius: 8, count: 1, predictive: 0.25, cooldown: 2100)
            reproduce(children: "Malphas Flamer", density_radius: 24, density_max: 5, cooldown: 500)
            toss_object(child: "Malphas Flamer", range: 6, angle: 0, cooldown: 9000)
            toss_object(child: "Malphas Flamer", range: 6, angle: 90, cooldown: 9000)
            toss_object(child: "Malphas Flamer", range: 6, angle: 180, cooldown: 9000)
            toss_object(child: "Malphas Flamer", range: 6, angle: 270, cooldown: 9000)
            on timed(time: 8000) -> Temporary_exhaustion
        }
        state Temporary_exhaustion {
            flash(color: 4737096, flash_period: 0.6, flash_repeats: 5)
            stay_back(speed: 0.4, distance: 4)
            on timed(time: 3200) -> Missile_Fire
        }
    }
    drop_portal_on_death(target: "Realm Portal", probability: 1)
    loot {
        threshold(0.01) { tier(tier: 7, type: weapon, probability: 0.2) tier(tier: 9, type: weapon, probability: 0.11) tier(tier: 10, type: weapon, probability: 0.05) tier(tier: 7, type: armor, probability: 0.2) tier(tier: 9, type: armor, probability: 0.11) tier(tier: 10, type: armor, probability: 0.05) tier(tier: 3, type: ability, probability: 0.1) tier(tier: 4, type: ability, probability: 0.06) tier(tier: 3, type: ring, probability: 0.1) tier(tier: 4, type: ring, probability: 0.06) item(item: "Wine Cellar Incantation", probability: 0.01) item(item: "Potion of Vitality", probability: 0.3, num_required: 1) item(item: "Potion of Defense", probability: 0.3) item(item: "Demon Blade", probability: 0.01) }
    }
}

enemy "Malphas Flamer" {
    state Attacking {
        state Charge {
            prioritize() {
                follow(speed: 0.7, acquire_range: 10, range: 0.1)
            }
            on player_within(dist: 2, see_invis: true) -> Bullet1
        }
        state Bullet1 {
            change_size(rate: 20, target: 130)
            flash(color: 16755200, flash_period: 0.2, flash_repeats: 20)
            shoot(radius: 8, cooldown: 200)
            on timed(time: 4000) -> Wait1
        }
        state Wait1 {
            change_size(rate: -20, target: 70)
            charge(speed: 3, range: 20, cooldown: 600)
        }
        on hp_below(threshold: 0.2) -> FlashBeforeExplode
    }
    state FlashBeforeExplode {
        flash(color: 16711680, flash_period: 0.75, flash_repeats: 1)
        on timed(time: 300) -> Explode
    }
    state Explode {
        shoot(radius: 0, count: 8, shoot_angle: 45, default_angle: 0)
        decay(time: 100)
    }
    loot {
        threshold(0.01) { item("Health Potion", 0.1) item("Magic Potion", 0.1) }
    }
}

