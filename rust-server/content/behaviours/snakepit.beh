            on timed(1000, "Silver Blast 16") -> Silver_Blast_16
        }
        state Silver_Blast_16 {
            shoot(10, count: 1, projectile: 0)
            shoot(10, count: 1, angle_offset: 270, projectile: 0)
            shoot(10, count: 1, angle_offset: 90, projectile: 0)
            on timed(1000, "Leave me") -> Leave_me
        }
        state Leave_me {
            conditional_effect(invulnerable)
            order(100, "Stheno Swarm", "Despawn")
            on timed(1000, "Blind Ring Attack + ThrowAttack") -> Blind_Ring_Attack___ThrowAttack
        }
    }
    state Blind_Ring_Attack___ThrowAttack {
        return_to_spawn(speed: 0.3)
        state Blind_Ring_Attack___ThrowAttack_1 {
            shoot(10, count: 6, projectile: 1)
            grenade(2.5, 100, 10)
            on timed(500, "Blind Ring Attack + ThrowAttack 2") -> Blind_Ring_Attack___ThrowAttack_2
        }
        state Blind_Ring_Attack___ThrowAttack_2 {
            shoot(10, count: 6, projectile: 1)
            grenade(2.5, 100, 10)
            on timed(500, "Blind Ring Attack + ThrowAttack 3") -> Blind_Ring_Attack___ThrowAttack_3
