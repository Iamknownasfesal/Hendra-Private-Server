            shoot(10, count: 1, angle_offset: 225, projectile: 0)
            shoot(10, count: 2, shoot_angle: 10, angle_offset: 315, projectile: 0)
            on timed(1000, "Silver Blasts 2") -> Silver_Blasts_2
        }
        state Silver_Blasts_2 {
            conditional_effect(invulnerable)
            shoot(10, count: 2, shoot_angle: 10, angle_offset: 45, projectile: 0)
