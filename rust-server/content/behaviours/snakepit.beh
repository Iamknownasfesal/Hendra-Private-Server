enemy "Stheno Swarm" {
    state Protect {
        prioritize() {
            protect(0.3, "Stheno the Snake Queen")
            wander(0.3)
        }
        shoot(10)
    }
    state Despawn {
        suicide()
    }
}

enemy "Stheno Pet" {
    state Protect_2 {
        shoot(25, cooldown: 1000)
        state Protect {
            on entity_not_exists("Stheno the Snake Queen", 100) -> Wander
            orbit(7.5, 10, acquire_range: 50, target: "Stheno the Snake Queen")
        }
        state Wander {
            prioritize() {
                wander(1)
            }
        }
    }
}

enemy "Pit Snake" {
    prioritize() {
        stay_close_to_spawn(1)
        wander(1)
    }
    shoot(20, cooldown: 1000)
}

enemy "Pit Viper" {
    prioritize() {
        stay_close_to_spawn(1)
        wander(1)
    }
    shoot(20, cooldown: 1000)
}

enemy "Yellow Python" {
    prioritize() {
        follow(1, 10, 1)
        stay_close_to_spawn(1)
        wander(1)
    }
    shoot(20, cooldown: 1000)
    loot {
        item("Snake Oil", 0.1)
        item("Ring of Speed", 0.1)
        item("Ring of Vitality", 0.1)
    }
}

enemy "Brown Python" {
    prioritize() {
        stay_close_to_spawn(1)
        wander(1)
    }
    shoot(20, cooldown: 1000)
    loot {
        item("Snake Oil", 0.1)
        item("Leather Armor", 0.1)
        item("Ring of Wisdom", 0.1)
    }
}

enemy "Fire Python" {
    prioritize() {
        follow(1, 10, 1, cooldown: 2000)
        wander(1)
    }
    shoot(15, count: 3, shoot_angle: 5, cooldown: 1000)
    loot {
        item("Snake Oil", 0.1)
        item("Fire Bow", 0.1)
        item("Fire Nova Spell", 0.1)
    }
}

enemy "Greater Pit Snake" {
    prioritize() {
        follow(1, 10, 5)
        wander(1)
    }
    shoot(15, count: 3, shoot_angle: 5, cooldown: 1000)
    loot {
        item("Snake Oil", 0.1)
        item("Glass Sword", 0.1)
        item("Avenger Staff", 0.1)
        item("Wand of Dark Magic", 0.1)
    }
}

enemy "Greater Pit Viper" {
    prioritize() {
        follow(1, 10, 5)
        wander(1)
    }
    shoot(15, cooldown: 300)
    loot {
        item("Snake Oil", 0.1)
        threshold
    }
}

enemy "Snakepit Guard" {
    change_size(100, 100)
    shoot(25, count: 3, shoot_angle: 25, projectile: 0)
    shoot(10, count: 6, projectile: 1, cooldown: 1000)
    state Phase_1 {
        prioritize() {
            stay_close_to_spawn(0.2, 4)
            wander(0.2)
        }
        on hp_below(0.6, "Phase 2") -> Phase_2
    }
    state Phase_2 {
        prioritize() {
            follow(0.2, acquire_range: 10, range: 3)
            wander(0.2)
        }
        shoot(15, count: 3, projectile: 2, cooldown: 2000)
    }
    loot {
        threshold
        threshold
    }
}

enemy "Snakepit Dart Thrower" {
    conditional_effect(invincible, true)
    state Idle {
    }
    state Protect_the_Guard {
        on entity_not_exists("Snakepit Guard", 40) -> Idle
    }
}

enemy "Snakepit Button" {
    conditional_effect(invincible, true)
    state Idle {
        on player_within(0.5) -> Order
    }
    state Order {
        order(15, "Snakepit Guard Spawner", "Spawn the Guard")
        set_alt_texture(1)
        on timed(0, "I am out") -> I_am_out
    }
    state I_am_out {
    }
}

enemy "Snakepit Guard Spawner" {
    conditional_effect(invincible, true)
    state Idle {
    }
    state Spawn_the_Guard {
        order(15, "Snakepit Dart Thrower", "Protect the Guard")
        spawn("Snakepit Guard", max_children: 1, initial_spawn: 1)
        on timed(0) -> Idle
    }
}

enemy "Snake Grate" {
    state Idle {
        on entity_not_exists("Pit Snake", 5, "Spawn Pit Snake") -> Spawn_Pit_Snake
        on entity_not_exists("Pit Viper", 5, "Spawn Pit Viper") -> Spawn_Pit_Viper
    }
    state Spawn_Pit_Snake {
        spawn("Pit Snake", 1, 1)
        on timed(2000) -> Idle
    }
    state Spawn_Pit_Viper {
        spawn("Pit Viper", 1, 1)
        on timed(2000) -> Idle
    }
}

