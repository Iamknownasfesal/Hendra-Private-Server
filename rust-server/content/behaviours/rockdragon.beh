enemy "Dragon Head" {
    reproduce("Rock Dragon Bat", 5, 5, cooldown: 10000)
    drop_portal_on_death("Lair of Draconis Portal")
    state default {
        on player_within(10) -> spawnbody
    }
    state spawnbody {
        change_size(60, 120)
        set_alt_texture(0)
        conditional_effect(invulnerable)
        spawn("Body Segment A", 1, 1, cooldown: 99999)
        spawn("Body Segment B", 1, 1, cooldown: 99999)
        spawn("Body Segment C", 1, 1, cooldown: 99999)
        spawn("Body Segment D", 1, 1, cooldown: 99999)
        spawn("Body Segment E", 1, 1, cooldown: 99999)
        spawn("Body Segment F", 1, 1, cooldown: 99999)
        spawn("Body Segment G", 1, 1, cooldown: 99999)
        spawn("Body Segment H", 1, 1, cooldown: 99999)
        spawn("Body Segment I", 1, 1, cooldown: 99999)
        spawn("Body Segment Tail", 1, 1, cooldown: 99999)
        on timed(400) -> weirdmovement
    }
    state weirdmovement {
        conditional_effect(invulnerable)
        stay_above(2, 265)
        sequence() {
            timed(1000) {
                return_to_spawn(0.6)
            }
            timed(5000) {
                prioritize() {
                    swirl(1.25, 8, targeted: false)
                    wander(0.2)
                }
            }
            timed(700) {
                prioritize() {
                    follow(0.9, 11, 1)
                    stay_close_to_spawn(0.5, 3)
                }
            }
        }
        shoot(4, count: 8, shoot_angle: 8, projectile: 1, cooldown: 1250)
        on entities_not_exists(9999, "Body Segment A", "Body Segment B", "Body Segment C", "Body Segment D", "Body Segment E", "Body Segment F", "Body Segment G", "Body Segment H", "Body Segment I") -> vulnerable
    }
    state vulnerable {
        change_size(60, 165)
        set_alt_texture(1)
        remove_entity(9999, "Body Segment Tail")
        sequence() {
            timed(1250) {
                return_to_spawn(0.6)
            }
            timed(1000) {
                back_and_forth(0.96, 5)
            }
            timed(2700) {
                prioritize() {
                    follow(1.1, 11, 1)
                    stay_close_to_spawn(0.95, 8)
                }
            }
        }
        shoot(8, count: 6, projectile: 3, cooldown: 3000)
        shoot(10, 1, projectile: 2, cooldown: 4123)
        on timed(11000) -> spawnbody
    }
    loot {
        threshold(0.05) {  }
        threshold(0.05) {  }
        threshold(0.01) { tier(8, weapon, 0.15) tier(9, weapon, 0.1) tier(10, weapon, 0.07) tier(11, weapon, 0.05) tier(4, ability, 0.15) tier(5, ability, 0.07) tier(8, armor, 0.2) tier(9, armor, 0.15) tier(10, armor, 0.1) tier(11, armor, 0.07) tier(12, armor, 0.04) tier(5, ring, 0.03) item("Potion of Defense", 0.1) item("Potion of Attack", 0.1) item("Potion of Vitality", 0.1) item("Potion of Wisdom", 0.1) item("Potion of Speed", 0.1) item("Potion of Dexterity", 0.1) item("Ray Katana", 0.01) item("FireStorm", 0.001) item("Ring of Boiling Lava", 0.005) item("Seal of Splashing Lava", 0.005) item("Flaming Sword of Fury", 0.005) item("Steel Armor of Magma", 0.005) }
    }
}

enemy "Body Segment Bomb" {
    state BoutToBlow {
        on timed(1620) -> bom
    }
    state bom {
        shoot(8.4, count: 13, projectile: 0)
        suicide()
    }
}

enemy "Body Segment A" {
    transform_on_death("Body Segment Bomb", 1, 1, 1)
    state go {
        protect(0.97, "Dragon Head", protection_range: 1)
    }
}

enemy "Body Segment B" {
    transform_on_death("Body Segment Bomb", 1, 1, 1)
    state go {
        protect(0.97, "Body Segment A", protection_range: 1)
        on entities_not_exists(9999, "2plan", "Body Segment A") -> s2plan
    }
    state s2plan {
        protect(0.97, "Dragon Head", protection_range: 1)
    }
}

