enemy "Rock Dragon Bat" {
    state BoutToBlow {
        prioritize() {
            follow(0.5, 8, 1)
            wander(0.2)
        }
        shoot(7, count: 3, shoot_angle: 8, projectile: 3, cooldown: 1300)
        on hp_below(0.11) -> bom
        on timed(5500) -> bom
    }
    state bom {
        shoot(8.4, count: 7, projectile: 2)
        suicide()
    }
}

