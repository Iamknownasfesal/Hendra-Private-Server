enemy "shtrs Stone Paladin" {
    state Idle {
        prioritize() {
            wander(0.8)
        }
        conditional_effect(invulnerable)
        reproduce(density_max: 4)
        on player_within(8) -> Attacking
    }
    state Attacking {
        state Bullet {
            shoot(1, 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 0, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 100, cooldown_offset: 200, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 110, cooldown_offset: 400, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 120, cooldown_offset: 600, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 130, cooldown_offset: 800, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 140, cooldown_offset: 1000, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 150, cooldown_offset: 1200, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 160, cooldown_offset: 1400, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 170, cooldown_offset: 1600, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 180, cooldown_offset: 1800, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 180, cooldown_offset: 2000, shoot_angle: 45)
            shoot(1, 4, cooldown: 10000, fixed_angle: 180, cooldown_offset: 0, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 170, cooldown_offset: 200, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 160, cooldown_offset: 400, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 150, cooldown_offset: 600, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 140, cooldown_offset: 800, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 130, cooldown_offset: 1000, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 120, cooldown_offset: 1200, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 110, cooldown_offset: 1400, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 100, cooldown_offset: 1600, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 1800, shoot_angle: 90)
            shoot(1, 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 2000, shoot_angle: 22.5)
            on timed(2000) -> Wait
        }
        state Wait {
            follow(0.4, range: 2)
            flash(4278255360, 0.1, 20)
            conditional_effect(invulnerable)
            on timed(2000) -> Bullet
        }
        on no_player_within(13) -> Idle
    }
}

enemy "shtrs Stone Knight" {
    state Follow {
        follow(0.6, 10, 5)
        on player_within(5) -> Charge
    }
    state Charge {
        on timed(2000) -> Follow
        charge(2.5, 6, cooldown: 2000)
        shoot(5, 16, projectile: 0, cooldown: 2400, cooldown_offset: 400)
    }
}

enemy "shtrs Lava Souls" {
    state active {
        follow(0.7, range: 0)
        on player_within(2) -> blink
    }
    state blink {
        flash(268369920, flash_repeats: 10000, flash_period: 0.1)
        on timed(2000) -> explode
    }
    state explode {
        flash(268369920, flash_repeats: 5, flash_period: 0.1)
        shoot(5, 9)
        suicide()
    }
}

enemy "shtrs Glassier Archmage" {
    stay_back(0.5, 5)
    state s1st {
        follow(0.8, range: 7)
        shoot(20, projectile: 2, count: 1, cooldown: 50)
        on timed(5000) -> next
    }
    state next {
        shoot(35, projectile: 0, count: 25, cooldown: 5000)
        on timed(25, "1st") -> s1st
    }
}

enemy "shtrs Ice Adept" {
    state Main {
        on timed(5000) -> Throw
        follow(0.8, range: 1)
        shoot(10, 1, projectile: 0, cooldown: 100, predictive: 1)
        shoot(10, 3, projectile: 1, shoot_angle: 10, cooldown: 4000, predictive: 1)
    }
    state Throw {
        toss_object("shtrs Ice Portal", 5, cooldown: 8000, cooldown_offset: 7000)
        on timed(1000) -> Main
    }
}

enemy "shtrs Fire Adept" {
    state Main {
        on timed(5000) -> Throw
        follow(0.8, range: 1)
        shoot(10, 1, projectile: 0, cooldown: 100, predictive: 1)
        shoot(10, 3, projectile: 1, shoot_angle: 10, cooldown: 4000, predictive: 1)
    }
    state Throw {
        toss_object("shtrs Fire Portal", 5, cooldown: 8000, cooldown_offset: 7000)
        on timed(1000) -> Main
    }
}

enemy "shtrs MagiGenerators" {
    state Main {
        conditional_effect(invulnerable)
        shoot(15, 10, cooldown: 1000)
        shoot(15, 1, projectile: 1, cooldown: 2500)
        on entities_not_exists(30, "Shtrs Twilight Archmage", "shtrs Inferno", "shtrs Blizzard") -> Hide
    }
    state Hide {
        set_alt_texture(1)
        conditional_effect(invulnerable)
    }
    state vulnerable {
        conditional_effect(armored)
    }
    state Despawn {
        decay()
    }
}

