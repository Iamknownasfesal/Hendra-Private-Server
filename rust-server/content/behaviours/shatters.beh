enemy "shtrs The Cursed Crown" {
    state Idle {
        conditional_effect(invincible, true)
        on entity_not_exists("shtrs Royal Guardian L", 100) -> Open
    }
    state Open {
        conditional_effect(invincible, true)
        move_to2(0, -15, 0.5)
        on timed(3000) -> WADAFAK
    }
    state WADAFAK {
        transform_on_death("shtrs The Forgotten King")
        suicide()
    }
}

enemy "shtrs Loot Balloon King" {
    state Idle {
        conditional_effect(invulnerable)
        on timed(5000) -> Crown
    }
    state Crown {
    }
    loot {
        threshold
    }
}

