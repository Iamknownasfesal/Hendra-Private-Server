enemy "shtrs Royal Guardian J" {
    state shoot {
        orbit(0.35, 2, 5, "shtrs The Forgotten King")
        shoot(15, 8, projectile: 0)
    }
}

enemy "shtrs Royal Guardian L" {
    state s1st {
        follow(1, 8, 5)
        shoot(15, 20, projectile: 0)
        on timed(1000, "2nd") -> s2nd
    }
    state s2nd {
        follow(1, 8, 5)
        shoot(10, projectile: 1)
        on timed(1000, "3rd") -> s3rd
    }
    state s3rd {
        follow(1, 8, 5)
        shoot(10, projectile: 1)
        on timed(1000, "1st") -> s1st
    }
}

enemy "shtrs Green Crystal" {
    heal_group(30, "Crystals", cooldown: 2000, heal_amount: 1500)
    state spawn {
        conditional_effect(invincible)
        orbit(0.4, 1, 5, "shtrs The Forgotten King")
        on timed(7000) -> follow
    }
    state follow {
        follow(0.4, range: 6)
        follow(0.6, range: 2)
        on timed(3000) -> dafuq
    }
    state dafuq {
        orbit(1, 4, 10, "shtrs Crystal Tracker")
        follow(0.4, range: 6)
        follow(0.4, range: 2, duration: 2000, cooldown: 1500)
        on timed(2000) -> follow
    }
}

enemy "shtrs Yellow Crystal" {
    state spawn {
