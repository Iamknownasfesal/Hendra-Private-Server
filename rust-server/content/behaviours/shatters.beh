    on hp_below(0.2) -> Death
    charge(0.6, 7, cooldown: 5000)
    shoot(3, 6, 60, projectile: 0, fixed_angle: 0, cooldown: 1200)
    shoot(3, 6, 60, projectile: 0, fixed_angle: 10, cooldown: 1200, cooldown_offset: 200)
    shoot(3, 6, 60, projectile: 0, fixed_angle: 20, cooldown: 1200, cooldown_offset: 400)
