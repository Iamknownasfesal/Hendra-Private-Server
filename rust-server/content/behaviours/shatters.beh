}

enemy "shtrs Crystal Tracker" {
    follow(2, 10, 1)
}

enemy "shtrs king timer" {
    conditional_effect(invincible)
    state wait {
        on entity_not_exists("shtrs The Forgotten King", 100) -> death
    }
    state timer1 {
        on timed(28000) -> heheh
    }
    state heheh {
        order(60, "shtrs The Forgotten King", "heheh")
        on timed(1) -> wait
    }
    state death {
        suicide()
    }
}

enemy "shtrs king lava1" {
    conditional_effect(invincible)
    state wait {
        conditional_effect(invisible)
    }
    state lava {
        replace_tile("Dark Cobblestone", "Hot Lava", 0)
    }
    state death {
        suicide()
    }
}

