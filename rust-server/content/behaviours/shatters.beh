        copy_damage_on_death("shtrs Loot Balloon King")
        order(1, "shtrs Chest Spawner 3", "Open")
        taunt("Impossible..........IMPOSSIBLE!")
        on timed(2000) -> Suicide
    }
    state Suicide {
        shoot(35, projectile: 0, count: 30)
        suicide()
    }
