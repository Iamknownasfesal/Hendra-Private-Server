enemy "shtrs obelisk controller" {
    conditional_effect(invincible)
    state wait {
        on entities_not_exists(30, "shtrs Bridge Obelisk A", "shtrs Bridge Obelisk B", "shtrs Bridge Obelisk D", "shtrs Bridge Obelisk E") -> obeliskshoot
    }
    state obeliskshoot {
        order(60, "shtrs Bridge Obelisk A", "Shoot")
        order(60, "shtrs Bridge Obelisk B", "Shoot")
        order(60, "shtrs Bridge Obelisk D", "Shoot")
        order(60, "shtrs Bridge Obelisk E", "Shoot")
    }
    state guardiancheck {
        order(60, "shtrs Bridge Obelisk A", "Pause")
        order(60, "shtrs Bridge Obelisk B", "guardiancheck")
        order(60, "shtrs Bridge Obelisk D", "guardiancheck")
        order(60, "shtrs Bridge Obelisk E", "guardiancheck")
        on timed(1) -> leavemychecksalone
    }
    state leavemychecksalone {
        conditional_effect(invincible)
    }
}

enemy "shtrs obelisk timer" {
    conditional_effect(invincible)
    state wait {
        on entities_not_exists(30, "shtrs Bridge Obelisk A", "shtrs Bridge Obelisk B", "shtrs Bridge Obelisk D", "shtrs Bridge Obelisk E") -> timer1
    }
    state timer1 {
        order(60, "shtrs obelisk controller", "obeliskshoot")
        on timed(10000) -> guardiancheck
    }
    state guardiancheck {
        order(60, "shtrs obelisk controller", "guardiancheck")
        on timed(1) -> leavemychecksalone
    }
    state leavemychecksalone {
        on timed(7000) -> timer1
    }
}

