enemy "shtrs Blobomb" {
    state active {
        follow(0.7, acquire_range: 40, range: 0)
        on player_within(2) -> blink
    }
    state blink {
        flash(268369920, flash_repeats: 10000, flash_period: 0.1)
        on timed(2000) -> explode
    }
    state explode {
        flash(268369920, flash_repeats: 5, flash_period: 0.1)
        shoot(30, 36, fixed_angle: 0)
        suicide()
    }
}

enemy "shtrs Twilight Archmage" {
    on hp_below(0.1) -> Death
    state Idle {
        conditional_effect(invulnerable)
        on entities_not_exists(6, "shtrs Archmage of Flame") -> Wake
    }
    state Wake {
        state Comment1 {
            conditional_effect(invulnerable)
            set_alt_texture(1)
            taunt("Ha...ha........hahahahahaha! You will make a fine sacrifice!")
            on timed(3000) -> Comment2
        }
        set_alt_texture(1)
        state Comment2 {
            conditional_effect(invulnerable)
            taunt("You will find that it was...unwise...to wake me.")
            on timed(1000) -> Comment3
        }
        state Comment3 {
            conditional_effect(invulnerable)
            set_alt_texture(1)
            taunt("Let us see what can conjure up!")
            on timed(1000) -> Comment4
        }
        state Comment4 {
            conditional_effect(invulnerable)
            set_alt_texture(1)
            taunt("I will freeze the life from you!")
            on timed(1000) -> Shoot
        }
    }
    state TossShit {
        toss_object("shtrs Ice Portal", 10, cooldown: 25000)
        toss_object("shtrs FireBomb", 15, cooldown: 25000)
        toss_object("shtrs FireBomb", 15, cooldown: 25000)
        toss_object("shtrs FireBomb", 7, cooldown: 25000)
        toss_object("shtrs FireBomb", 1, cooldown: 25000)
        toss_object("shtrs FireBomb", 4, cooldown: 25000)
        toss_object("shtrs FireBomb", 8, cooldown: 25000)
        toss_object("shtrs FireBomb", 9, cooldown: 25000)
        toss_object("shtrs FireBomb", 5, cooldown: 25000)
        toss_object("shtrs FireBomb", 7, cooldown: 25000)
        toss_object("shtrs FireBomb", 11, cooldown: 25000)
        toss_object("shtrs FireBomb", 13, cooldown: 25000)
        toss_object("shtrs FireBomb", 12, cooldown: 25000)
        toss_object("shtrs FireBomb", 10, cooldown: 25000)
        spawn("shtrs Ice Shield 2", max_children: 1, initial_spawn: 1, cooldown: 25000)
        on timed(1) -> Shoot
    }
    state Shoot {
        shoot(15, 5, 5, projectile: 1, cooldown: 800)
        shoot(15, 5, 5, projectile: 1, cooldown: 800, cooldown_offset: 200)
        shoot(15, 5, 5, projectile: 1, cooldown: 800, cooldown_offset: 400)
        shoot(15, 5, 5, projectile: 1, cooldown: 800, cooldown_offset: 600)
        shoot(15, 5, 5, projectile: 1, cooldown: 800, cooldown_offset: 800)
        on timed(800) -> Shoot
        on hp_below(0.5, "Pre Birds") -> Pre_Birds
    }
    state Pre_Birds {
        conditional_effect(invulnerable)
        taunt("You leave me no choice...Inferno! Blizzard!")
        on timed(2000) -> Birds
    }
    state Birds {
        conditional_effect(invulnerable)
        spawn("shtrs Inferno", max_children: 1, initial_spawn: 1, cooldown: 1000000000)
        spawn("shtrs Blizzard", max_children: 1, initial_spawn: 1, cooldown: 1000000000)
        on entities_not_exists(500, "shtrs Inferno", "shtrs Blizzard") -> PreNewShit2
    }
    state PreNewShit2 {
        conditional_effect(invulnerable)
        return_to_spawn(1)
        on timed(3000) -> NewShit2
    }
    state NewShit2 {
        conditional_effect(invulnerable)
        move_to2(0, -6, 1)
        on timed(3000) -> Active2
    }
    state Active2 {
        taunt("THE POWER...IT CONSUMES ME!")
        order(2, "shtrs MagiGenerators", "vulnerable")
        shoot(15, 20, projectile: 2, cooldown: 100000000, cooldown_offset: 100)
