    }
}

enemy "shtrs Red Crystal" {
    state spawn {
        conditional_effect(invincible)
        orbit(0.4, 1, 5, "shtrs The Forgotten King")
        on timed(7000) -> orbit
    }
    state orbit {
        toss_object("shtrs Fire Portal", 5, cooldown: 8000)
        orbit(1, 4, 10, "shtrs Crystal Tracker")
        follow(0.4, range: 6)
        follow(0.4, range: 6)
        on timed(5000) -> ThrowPortal
    }
    state ThrowPortal {
        orbit(1, 4, 10, "shtrs Crystal Tracker")
        follow(0.4, range: 6)
        follow(0.4, range: 6)
        toss_object("shtrs Fire Portal", 5, cooldown: 8000)
        on timed(8000) -> orbit
    }
}

enemy "shtrs Blue Crystal" {
    state spawn {
        conditional_effect(invincible)
        orbit(0.4, 1, 5, "shtrs The Forgotten King")
        on timed(7000) -> orbit
    }
    state orbit {
        toss_object("shtrs Ice Portal", 5, cooldown: 8000)
        orbit(1, 4, 10, "shtrs Crystal Tracker")
