    shoot(3, 6, 60, projectile: 0, fixed_angle: 50, cooldown: 1200, cooldown_offset: 1000)
    state Death {
        conditional_effect(invulnerable)
        shoot(13, 45, 8, projectile: 1, fixed_angle: 1, cooldown: 10000)
        timed(1000) {
            suicide()
        }
    }
}

enemy "shtrs Ice Shield 2" {
    on hp_below(0.3) -> Death
    orbit(0.5, 5, 1, "shtrs Twilight Archmage")
    charge(0.1, 6, cooldown: 10000)
    shoot(13, 10, 8, projectile: 0, cooldown: 1000, fixed_angle: 1)
    state Death {
        conditional_effect(invincible)
        shoot(13, 45, projectile: 1, cooldown: 10000)
        timed(1000) {
            suicide()
        }
    }
}

