enemy "shtrs blobomb maker" {
    state Idle {
        conditional_effect(invincible)
    }
    state Spawn {
        spawn("shtrs Blobomb", cooldown: 1500)
        on timed(3000) -> Spawn2
    }
    state Spawn2 {
        spawn("shtrs Blobomb", cooldown: 1000)
        on timed(3000) -> Idle
    }
}

enemy "shtrs Lava Souls maker" {
    state Idle {
        conditional_effect(invincible)
    }
    state Spawn {
        spawn("shtrs Lava Souls", max_children: 1, cooldown: 8000)
        on timed(8000) -> Spawn2
    }
    state Spawn2 {
        spawn("shtrs Lava Souls", max_children: 1, cooldown: 8000)
        on timed(8000) -> Spawn
    }
}

enemy "shtrs Chest Spawner 3" {
    state Idle {
        conditional_effect(invincible, true)
        on entities_not_exists(30, "shtrs The Cursed Crown", "shtrs The Forgotten King") -> Open
    }
    state Open {
        transform_on_death("shtrs Loot Balloon King")
        suicide()
    }
