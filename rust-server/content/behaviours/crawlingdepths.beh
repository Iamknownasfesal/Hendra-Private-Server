enemy "Yellow Son of Arachna Giant Egg Sac" {
    transform_on_death("Yellow Egg Summoner")
    state Spawn {
        spawn("Crawling Green Spider", 2)
        on entity_not_exists("Crawling Green Spider", 20) -> Spawn2
    }
    state Spawn2 {
        spawn("Crawling Grey Spider", 2)
        on entity_not_exists("Crawling Grey Spider", 20) -> Spawn3
    }
    state Spawn3 {
        spawn("Crawling Red Spotted Spider", 2)
        on entity_not_exists("Crawling Red Spotted Spider", 20) -> Spawn4
    }
    state Spawn4 {
        spawn("Crawling Spider Hatchling", 2)
        on entity_not_exists("Crawling Spider Hatchling", 20) -> Spawn5
    }
    state Spawn5 {
        spawn("Crawling Grey Spotted Spider", 2)
        on entity_not_exists("Crawling Grey Spotted Spider", 20) -> Spawn
    }
    loot {
        threshold
    }
}

