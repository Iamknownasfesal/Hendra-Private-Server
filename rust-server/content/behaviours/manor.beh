enemy "Lord Ruthven" {
    realm_portal_drop()
    state default {
        on player_within(8) -> spooksters
    }
    state spooksters {
        wander(0.2)
        shoot(10, count: 5, shoot_angle: 2, projectile: 0, cooldown: 900)
        on timed(6000) -> spooksters2
    }
    state spooksters2 {
        wander(0.15)
        shoot(8.4, count: 40, projectile: 1, cooldown: 2750)
        shoot(10, count: 5, shoot_angle: 2, projectile: 0, cooldown: 900)
        on timed(4000) -> spooksters3
    }
    state spooksters3 {
        heal_self(cooldown: 1250)
        shoot(8.4, count: 40, projectile: 1, cooldown: 2750)
        on timed(4000) -> spooksters
    }
    loot {
        threshold
        threshold
    }
}

enemy "Hellhound" {
    follow(1.25, 8, 1, cooldown: 275)
    shoot(10, count: 5, shoot_angle: 7, cooldown: 2000)
    loot {
        item("Magic Potion", 0.05)
        threshold
    }
}

enemy "Vampire Bat Swarmer" {
