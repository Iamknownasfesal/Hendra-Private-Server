enemy "Candy Gnome" {
    state Ini {
        wander(speed: 0.4)
        on player_within(dist: 14, see_invis: true) -> Main
    }
    state Main {
        follow(speed: 1.4, acquire_range: 17, range: 6)
        on timed(time: 1600) -> Flee
    }
    state Flee {
        on player_within(dist: 11, see_invis: true) -> RunAwayMed
        on player_within(dist: 8, see_invis: true) -> RunAwayMedFast
        on player_within(dist: 5, see_invis: true) -> RunAwayFast
        on player_within(dist: 16, see_invis: true) -> RunAwaySlow
    }
    state RunAwayFast {
        stay_back(speed: 1.9, distance: 30)
        on timed_random(1000, false, "RunAwayMed", "RunAwaySlow") -> RunAwayMedFast
    }
    state RunAwayMedFast {
        stay_back(speed: 1.45, distance: 30)
        on timed_random(1000, false, "RunAwaySlow") -> RunAwayMed
    }
    state RunAwayMed {
        stay_back(speed: 1.1, distance: 30)
        on timed_random(1000, false, "RunAwaySlow") -> RunAwayMedFast
    }
    state RunAwaySlow {
        stay_back(speed: 0.8, distance: 30)
        on timed_random(1000, false, "RunAwayMed") -> RunAwayMedFast
    }
    drop_portal_on_death(target: "Candyland Portal", probability: 0.5, timeout: 30)
    loot {
        threshold(0.01) { item(item: "Rock Candy", probability: 0.15) item(item: "Red Gumball", probability: 0.15) item(item: "Purple Gumball", probability: 0.15) item(item: "Blue Gumball", probability: 0.15) item(item: "Green Gumball", probability: 0.15) item(item: "Yellow Gumball", probability: 0.15) }
    }
}

enemy "MegaRototo" {
    reproduce(children: "Tiny Rototo", density_radius: 12, density_max: 7, cooldown: 7000)
    state Follow {
        shoot(radius: 0, count: 4, shoot_angle: 90, default_angle: 45, cooldown: 1400)
        shoot(radius: 0, count: 4, shoot_angle: 90, projectile: 1, cooldown: 1400)
        follow(speed: 0.45, acquire_range: 11, range: 5)
        on timed_random(4300, false, "StayBack") -> FlameThrower
    }
    state StayBack {
        shoot(radius: 0, count: 3, shoot_angle: 16, projectile: 1, predictive: 0.6, cooldown: 1200)
        shoot(radius: 0, count: 3, shoot_angle: 16, projectile: 0, predictive: 0.9, cooldown: 600)
        stay_back(speed: 0.5, distance: 10)
        on timed(time: 2400) -> Follow
    }
    state FlameThrower {
        state FB1ORFB2 {
            on timed_random(0, false, "FB2") -> FB1
        }
        state FB1 {
            shoot(radius: 12, count: 2, shoot_angle: 16, projectile: 2, cooldown: 400)
            shoot(radius: 12, count: 1, projectile: 3, cooldown: 200)
        }
        state FB2 {
            shoot(radius: 12, count: 2, shoot_angle: 16, projectile: 3, cooldown: 400)
            shoot(radius: 12, count: 1, projectile: 2, cooldown: 200)
        }
        on timed(time: 4000) -> Follow
    }
    loot {
        threshold(0.01) { item(item: "Ring Pop", probability: 0.02) item(item: "Wine Cellar Incantation", probability: 0.02) item(item: "Rock Candy", probability: 0.08) item(item: "Candy-Coated Armor", probability: 0.01) item(item: "Red Gumball", probability: 0.15) item(item: "Purple Gumball", probability: 0.15) item(item: "Blue Gumball", probability: 0.15) item(item: "Green Gumball", probability: 0.15) item(item: "Yellow Gumball", probability: 0.15) tier(tier: 7, type: weapon, probability: 0.04) tier(tier: 6, type: weapon, probability: 0.06) tier(tier: 8, type: armor, probability: 0.04) tier(tier: 7, type: armor, probability: 0.06) tier(tier: 3, type: ability, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) tier(tier: 3, type: ring, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) }
    }
}

enemy "Spoiled Creampuff" {
    spawn(children: "Big Creampuff", max_children: 2, initial_spawn: 0, gives_no_xp: false)
    reproduce(children: "Big Creampuff", density_radius: 24, density_max: 2, cooldown: 25000)
    shoot(radius: 10, count: 1, projectile: 0, predictive: 1, cooldown: 1400)
    shoot(radius: 4.4, count: 5, shoot_angle: 12, projectile: 1, predictive: 0.6, cooldown: 800)
    prioritize() {
        charge(speed: 1.4, range: 11, cooldown: 4200)
        stay_back(speed: 1, distance: 4)
        stay_back(speed: 0.5, distance: 7)
    }
    stay_close_to_spawn(speed: 1.35, range: 13)
    wander(speed: 0.4)
    loot {
        threshold(0.01) { item(item: "Potion of Attack", probability: 0.03) item(item: "Potion of Defense", probability: 0.03) item(item: "Ring Pop", probability: 0.015) item(item: "Wine Cellar Incantation", probability: 0.02) item(item: "Rock Candy", probability: 0.08) item(item: "Candy-Coated Armor", probability: 0.01) item(item: "Red Gumball", probability: 0.15) item(item: "Purple Gumball", probability: 0.15) item(item: "Blue Gumball", probability: 0.15) item(item: "Green Gumball", probability: 0.15) item(item: "Yellow Gumball", probability: 0.15) tier(tier: 7, type: weapon, probability: 0.04) tier(tier: 6, type: weapon, probability: 0.06) tier(tier: 8, type: armor, probability: 0.04) tier(tier: 7, type: armor, probability: 0.06) tier(tier: 3, type: ability, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) tier(tier: 3, type: ring, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) }
    }
}

enemy "Desire Troll" {
    state BaseAttack {
        shoot(radius: 10, count: 3, shoot_angle: 15, projectile: 0, predictive: 1, cooldown: 1400)
        grenade(radius: 5, damage: 200, range: 8, cooldown: 3000)
        shoot(radius: 10, count: 1, projectile: 1, predictive: 1, cooldown: 2000)
        state Choose {
            on timed_random(3800, false, "Attack") -> Run
        }
        state Run {
            stay_back(speed: 1.1, distance: 10)
            on timed(time: 1200) -> Choose
        }
        state Attack {
            charge(speed: 1.2, range: 11, cooldown: 1000)
            on timed(time: 1000) -> Choose
        }
        on hp_below(threshold: 0.6) -> NextAttack
    }
    state NextAttack {
        shoot(radius: 10, count: 5, shoot_angle: 10, projectile: 2, predictive: 0.5, angle_offset: 0.4, cooldown: 2000)
        shoot(radius: 10, count: 1, projectile: 1, predictive: 1, cooldown: 2000)
        shoot(radius: 10, count: 3, shoot_angle: 15, projectile: 0, predictive: 1, angle_offset: 1, cooldown: 4000)
        grenade(radius: 5, damage: 200, range: 8, cooldown: 3000)
        state Choose2 {
            on timed_random(3800, false, "Attack2") -> Run2
        }
        state Run2 {
            stay_back(speed: 1.5, distance: 10)
            on timed(time: 1500) -> Choose2
            on player_within(dist: 3.5, see_invis: false) -> Boom
        }
        state Attack2 {
            charge(speed: 1.2, range: 11, cooldown: 1000)
            on timed(time: 1000) -> Choose2
            on player_within(dist: 3.5, see_invis: false) -> Boom
        }
        state Boom {
            shoot(radius: 0, count: 20, shoot_angle: 18, projectile: 3, cooldown: 2000)
            on timed(time: 200) -> Choose2
        }
    }
    stay_close_to_spawn(speed: 1.5, range: 15)
    prioritize() {
        follow(speed: 1, acquire_range: 11, range: 5)
    }
    wander(speed: 0.4)
    loot {
        threshold(0.01) { item(item: "Potion of Attack", probability: 0.05) item(item: "Potion of Wisdom", probability: 0.05) item(item: "Ring Pop", probability: 0.015) item(item: "Wine Cellar Incantation", probability: 0.02) item(item: "Rock Candy", probability: 0.08) item(item: "Candy-Coated Armor", probability: 0.01) item(item: "Red Gumball", probability: 0.15) item(item: "Purple Gumball", probability: 0.15) item(item: "Blue Gumball", probability: 0.15) item(item: "Green Gumball", probability: 0.15) item(item: "Yellow Gumball", probability: 0.15) tier(tier: 7, type: weapon, probability: 0.04) tier(tier: 6, type: weapon, probability: 0.06) tier(tier: 8, type: armor, probability: 0.04) tier(tier: 7, type: armor, probability: 0.06) tier(tier: 3, type: ability, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) tier(tier: 3, type: ring, probability: 0.05) tier(tier: 4, type: ability, probability: 0.03) }
    }
}

enemy "Swoll Fairy" {
    spawn(children: "Fairy", max_children: 6, initial_spawn: 0, cooldown: 10000, gives_no_xp: false)
    stay_close_to_spawn(speed: 0.6, range: 13)
    prioritize() {
        follow(speed: 0.3, acquire_range: 10, range: 5)
    }
    state Shoot {
        shoot(radius: 11, count: 2, shoot_angle: 30, projectile: 0, predictive: 1, cooldown: 600)
        on timed(time: 3000) -> Pause
    }
    state ShootB {
        shoot(radius: 11, count: 8, shoot_angle: 45, projectile: 1, cooldown: 1000)
        on timed(time: 3000) -> Pause
    }
    state Pause {
        on timed_random(3000, false, "ShootB") -> Shoot
