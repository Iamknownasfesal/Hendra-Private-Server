enemy "Blood Ground Effector" {
    conditional_effect(invincible)
    apply_setpiece("Puke")
    suicide()
}

enemy "Epic Larva" {
    conditional_effect(armored)
    follow(0.08, 8, 1)
    shoot(8.4, count: 1, fixed_angle: 50, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 140, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 240, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 325, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 45, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 135, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 235, projectile: 0, cooldown: 1750)
    shoot(8.4, count: 1, fixed_angle: 315, projectile: 0, cooldown: 1750)
    toss_object("Blood Ground Effector", cooldown: 3750)
    on damage_taken(12500) -> tran
    state tran {
        conditional_effect(invulnerable)
        flash(16711680, 2, 2)
        on timed(8750) -> home
    }
    state home {
        transform_on_death("Epic Mama Megamoth", 1, 1)
        conditional_effect(invulnerable)
        flash(16711680, 2, 2)
        suicide()
    }
}

