enemy "Limon the Sprite God" {
    state start_the_fun {
        conditional_effect(invulnerable)
        on player_within(dist: 11, see_invis: true) -> begin_teleport1
    }
    state begin_teleport1 {
        conditional_effect(invulnerable)
        prioritize() {
            stay_close_to_spawn(speed: 0.5, range: 7)
            wander(speed: 0.5)
        }
        flash(color: 65280, flash_period: 0.25, flash_repeats: 8)
        on timed(time: 2000) -> teleport1
    }
    state teleport1 {
        prioritize() {
            stay_close_to_spawn(speed: 1.6, range: 7)
            follow(speed: 6, acquire_range: 10, range: 2)
            follow(speed: 0.3, acquire_range: 10, range: 0.2)
        }
        on timed(time: 300) -> circle_player
    }
    state circle_player {
        shoot(radius: 8, count: 2, shoot_angle: 10, projectile: 0, angle_offset: 0.7, predictive: 0.4, cooldown: 400)
        shoot(radius: 8, count: 2, shoot_angle: 180, projectile: 0, angle_offset: 0.7, predictive: 0.4, cooldown: 400)
        prioritize() {
            stay_close_to_spawn(speed: 1.3, range: 7)
            orbit(speed: 1.8, radius: 4, acquire_range: 5)
            follow(speed: 6, acquire_range: 10, range: 2)
            follow(speed: 0.3, acquire_range: 10, range: 0.2)
        }
        state check_if_not_moving {
            on not_moving(delay: 500) -> boom
        }
        state boom {
            shoot(radius: 8, count: 18, shoot_angle: 20, projectile: 0, angle_offset: 0.4, predictive: 0.4, cooldown: 1500)
            conditional_effect(invulnerable)
            on timed(time: 1000) -> check_if_not_moving
        }
        on timed(time: 10000) -> set_up_the_box
    }
    state set_up_the_box {
        toss_object(child: "Limon Element 1", range: 9.5, angle: 315, cooldown: 1000000)
        toss_object(child: "Limon Element 2", range: 9.5, angle: 225, cooldown: 1000000)
        toss_object(child: "Limon Element 3", range: 9.5, angle: 135, cooldown: 1000000)
        toss_object(child: "Limon Element 4", range: 9.5, angle: 45, cooldown: 1000000)
        toss_object(child: "Limon Element 1", range: 14, angle: 315, cooldown: 1000000)
        toss_object(child: "Limon Element 2", range: 14, angle: 225, cooldown: 1000000)
        toss_object(child: "Limon Element 3", range: 14, angle: 135, cooldown: 1000000)
        toss_object(child: "Limon Element 4", range: 14, angle: 45, cooldown: 1000000)
        state shielded1 {
            shoot(radius: 8, count: 1, predictive: 0.1, cooldown: 1000)
            shoot(radius: 8, count: 3, shoot_angle: 120, angle_offset: 0.3, predictive: 0.1, cooldown: 500)
            on timed(1500) -> shielded2
        }
        state shielded2 {
            conditional_effect(invulnerable)
            shoot(radius: 8, count: 3, shoot_angle: 120, angle_offset: 0.3, predictive: 0.2, cooldown: 800)
            on timed(3500) -> shielded2
        }
        on timed(time: 20000) -> Summon_the_sprites
    }
    state Summon_the_sprites {
        stay_close_to_spawn(speed: 0.5, range: 8)
        wander(speed: 0.5)
        conditional_effect(armored)
        shoot(radius: 8, count: 3, shoot_angle: 15, cooldown: 1300)
        spawn(children: "Magic Sprite", max_children: 2, initial_spawn: 0, cooldown: 500)
        spawn(children: "Ice Sprite", max_children: 1, initial_spawn: 0, cooldown: 500)
        on timed(time: 11000) -> begin_teleport1
        on hp_below(threshold: 0.2) -> begin_teleport1
    }
    drop_portal_on_death(target: "Glowing Realm Portal", probability: 1)
    loot {
        threshold(0.01) { tier(tier: 7, type: armor, probability: 0.15) tier(tier: 3, type: ability, probability: 0.11) tier(tier: 4, type: ability, probability: 0.124) tier(tier: 5, type: ability, probability: 0.11) tier(tier: 3, type: ring, probability: 0.11) item(item: "Potion of Dexterity", probability: 0.3, num_required: 1) item(item: "Potion of Defense", probability: 0.1) item(item: "Sprite Wand", probability: 0.01) item(item: "Wine Cellar Incantation", probability: 0.02) item(item: "Staff of Extreme Prejudice", probability: 0.01) item(item: "Cloak of the Planewalker", probability: 0.01) }
    }
}

enemy "Limon Element 1" {
    conditional_effect(invulnerable)
    on entity_not_exists(target: "Limon the Sprite God", dist: 999) -> Suicide
    state Setup {
        on timed(time: 2000) -> Attacking1
    }
    state Attacking1 {
        shoot(radius: 999, fixed_angle: 180, default_angle: 180, cooldown: 300)
        shoot(radius: 999, fixed_angle: 90, default_angle: 90, cooldown: 300)
        on timed(time: 6000) -> Attacking2
    }
    state Attacking2 {
        shoot(radius: 999, fixed_angle: 180, default_angle: 180, cooldown: 300)
        shoot(radius: 999, fixed_angle: 90, default_angle: 90, cooldown: 300)
        shoot(radius: 999, fixed_angle: 135, default_angle: 135, cooldown: 300)
        on timed(time: 6000) -> Attacking3
    }
    state Attacking3 {
        shoot(radius: 999, fixed_angle: 180, default_angle: 180, cooldown: 300)
        shoot(radius: 999, fixed_angle: 90, default_angle: 90, cooldown: 300)
        on timed(time: 6000) -> Setup
    }
    state Suicide {
        suicide()
    }
    decay(time: 20000)
}

