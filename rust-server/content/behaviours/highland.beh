enemy "Flamer King" {
    spawn("Flamer", max_children: 5, cooldown: 10000, gives_no_xp: false)
    state Attacking {
        state Charge {
            follow(0.7, range: 0.1)
            on player_within(2) -> Bullet
        }
        state Bullet {
            flash(4294945280, 0.2, 20)
            change_size(20, 140)
            shoot(8, cooldown: 200)
            on timed(4000) -> Wait
        }
        state Wait {
            change_size(-20, 80)
            on timed(500) -> Charge
        }
        on hp_below(0.2) -> FlashBeforeExplode
    }
    state FlashBeforeExplode {
        flash(4294901760, 1, 1)
        on timed(300) -> Explode
    }
    state Explode {
        shoot(0, count: 10, shoot_angle: 36, fixed_angle: 0)
        decay(0)
    }
    loot {
        tier(2, ring, 0.04)
    }
}

