    state if_cloaked {
        shoot(10, count: 8, shoot_angle: 45, fixed_angle: 20, cooldown: 1600, cooldown_offset: 400)
        shoot(10, count: 8, shoot_angle: 45, fixed_angle: 42, cooldown: 1600, cooldown_offset: 1200)
        on player_within(10) -> normal_attack
    }
    loot {
        threshold
    }
}

