        toss_object("Left Horizontal Trap", range: 9, angle: 230, cooldown: 100000)
        toss_object("Left Horizontal Trap", range: 10, angle: 180, cooldown: 100000)
        toss_object("Left Horizontal Trap", range: 9, angle: 140, cooldown: 100000)
