enemy "Minotaur" {
    state idle {
        stay_above(0.6, 160)
        on player_within(10) -> charge
    }
    state charge {
        prioritize() {
            stay_above(0.6, 160)
            follow(6, acquire_range: 11, range: 1.6)
        }
        on timed(200) -> spam_blades
    }
    state spam_blades {
        shoot(8, projectile: 0, count: 1, cooldown: 100000, cooldown_offset: 1000)
        shoot(8, projectile: 0, count: 2, shoot_angle: 16, cooldown: 100000, cooldown_offset: 1200)
        shoot(8, projectile: 0, count: 3, predictive: 0.2, cooldown: 100000, cooldown_offset: 1600)
        shoot(8, projectile: 0, count: 1, shoot_angle: 24, cooldown: 100000, cooldown_offset: 2200)
        shoot(8, projectile: 0, count: 2, predictive: 0.2, cooldown: 100000, cooldown_offset: 2800)
        shoot(8, projectile: 0, count: 3, shoot_angle: 16, cooldown: 100000, cooldown_offset: 3200)
        prioritize() {
            stay_above(0.6, 160)
            wander(0.6)
        }
        on timed(4400) -> blade_ring
    }
    state blade_ring {
        shoot(7, fixed_angle: 0, count: 12, shoot_angle: 30, cooldown: 800, projectile: 1, cooldown_offset: 600)
        shoot(7, fixed_angle: 15, count: 6, shoot_angle: 60, cooldown: 800, projectile: 2, cooldown_offset: 1000)
        prioritize() {
            stay_above(0.6, 160)
            follow(0.6, acquire_range: 10, range: 1)
            wander(0.6)
        }
        on timed(3500) -> pause
    }
    state pause {
        prioritize() {
            stay_above(0.6, 160)
            wander(0.6)
        }
        on timed(1000) -> idle
    }
    loot {
        threshold
    }
}

enemy "Ogre King" {
    spawn("Ogre Warrior", max_children: 4, cooldown: 12000, gives_no_xp: false)
    spawn("Ogre Mage", max_children: 2, cooldown: 16000, gives_no_xp: false)
    spawn("Ogre Wizard", max_children: 2, cooldown: 20000, gives_no_xp: false)
    state idle {
        prioritize() {
            stay_above(0.3, 160)
            wander(0.3)
        }
        on player_within(10) -> grenade_blade_combo
    }
    state grenade_blade_combo {
        state grenade1 {
            grenade(3, 60, cooldown: 100000)
            prioritize() {
                stay_above(0.3, 160)
                wander(0.3)
            }
            on timed(2000) -> grenade2
        }
        state grenade2 {
            grenade(3, 60, cooldown: 100000)
            prioritize() {
                stay_above(0.5, 160)
                wander(0.5)
            }
            on timed(3000) -> slow_follow
        }
        state slow_follow {
            shoot(13, cooldown: 1000)
            prioritize() {
                stay_above(0.4, 160)
                follow(0.4, acquire_range: 9, range: 3.5, duration: 4)
                wander(0.4)
            }
            on timed(4000) -> grenade1
        }
        on hp_below(0.45) -> furious
    }
    state furious {
        grenade(2.4, 55, range: 9, cooldown: 1500)
        prioritize() {
            stay_above(0.6, 160)
            wander(0.6)
        }
        on timed(12000) -> idle
    }
    loot {
        threshold
    }
}

