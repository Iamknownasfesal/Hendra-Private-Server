        stay_above(0.3, 160)
        follow(1, range: 7)
        wander(0.4)
    }
    state idle {
        on player_within(10.2) -> normal_attack
    }
    state normal_attack {
        shoot(10, count: 3, shoot_angle: 3, predictive: 0.5)
        on timed(4000) -> if_cloaked
