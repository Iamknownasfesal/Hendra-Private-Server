        toss_object("135-315 Diagonal Trap", range: 2, angle: 135, cooldown: 100000)
        toss_object("135-315 Diagonal Trap", range: 7, angle: 135, cooldown: 100000)
        toss_object("135-315 Diagonal Trap", range: 11, angle: 315, cooldown: 100000)
        toss_object("135-315 Diagonal Trap", range: 6, angle: 315, cooldown: 100000)
