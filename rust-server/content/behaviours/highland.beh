    shoot(10)
    state idle {
        on player_within(10.5) -> run1
    }
    state run1 {
        prioritize() {
            stay_above(0.4, 160)
            protect(1.1, "Undead Dwarf God", acquire_range: 16, protection_range: 10, reprotect_range: 1)
            wander(0.4)
        }
        on timed(2000) -> run2
    }
    state run2 {
        prioritize() {
            stay_above(0.4, 160)
            stay_back(0.8, distance: 4)
            wander(0.4)
        }
        on timed(1400) -> run3
    }
    state run3 {
        prioritize() {
            stay_above(0.4, 160)
            protect(1, "Undead Dwarf King", acquire_range: 16, protection_range: 2, reprotect_range: 2)
