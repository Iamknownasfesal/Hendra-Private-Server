enemy "Shield Orc Key" {
    spawn("Shield Orc Flooder", max_children: 1, initial_spawn: 1, cooldown: 10000, gives_no_xp: false)
    spawn("Shield Orc Shield", max_children: 1, initial_spawn: 1, cooldown: 10000, gives_no_xp: false)
    spawn("Shield Orc Shield", max_children: 1, initial_spawn: 1, cooldown: 10000, gives_no_xp: false)
    state Start {
        on timed(500) -> Attacking
    }
    state Attacking {
        orbit(1, 3, target: "Shield Orc Flooder")
        order(7, "Shield Orc Flooder", "Attacking")
        order(7, "Shield Orc Shield", "Attacking")
        on hp_below(0.5) -> FlashBeforeExplode
    }
    state FlashBeforeExplode {
        order(7, "Shield Orc Flooder", "Flash")
        order(7, "Shield Orc Shield", "Flash")
        flash(16711680, 1, 1)
        on timed(300) -> Explode
    }
    state Explode {
        shoot(0, count: 10, shoot_angle: 36, fixed_angle: 0)
        decay(0)
    }
    loot {
        tier(4, armor, 0.01)
    }
}

