enemy "Kage Kami" {
    drop_portal_on_death("Manor of the Immortals Portal", 0.5)
    state yay_i_am_good {
        taunt(0.5, "Kyoufu no kage!")
        conditional_effect(invincible)
        change_size(20, 120)
        set_alt_texture(1)
        on timed(2000) -> Attack
    }
    state Attack {
        wander(0.4)
        set_alt_texture(1)
        on timed(5000) -> Charge
        toss_object("Specter Mine", cooldown: 2000)
        state Shoot1 {
            shoot(0, count: 1, default_angle: 0, rotate_angle: 30, cooldown: 300, projectile: 1)
            shoot(0, count: 1, default_angle: 180, rotate_angle: 30, cooldown: 300, projectile: 1)
            on timed(1000) -> Shoot2
        }
        state Shoot2 {
            shoot(20, count: 2, shoot_angle: 180, cooldown: 400, projectile: 1)
            on timed(400) -> Shoot1
        }
    }
    state Charge {
        conditional_effect(invincible)
        toss_object("Specter Mine", cooldown: 2000)
        set_alt_texture(2)
        follow(0.8, 20, 1)
        shoot(20, count: 2, shoot_angle: 50, cooldown: 400)
        on timed(4000) -> Attack
    }
}

enemy "Specter Mine" {
    state Waiting {
        on player_within(3) -> Suicide
        on timed(4000) -> Suicide
    }
    state Suicide {
        shoot(60, count: 4, shoot_angle: 45)
        suicide()
    }
}

