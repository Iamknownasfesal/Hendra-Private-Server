enemy "Oryx Guardian TaskMaster" {
    conditional_effect(invincible, true)
    state Idle {
        on entities_not_exists(100, "Oryx Stone Guardian Right", "Oryx Stone Guardian Left") -> Death
    }
    state Death {
        spawn("Oryx's Chamber Portal", 1, 1)
        suicide()
    }
}

enemy "Oryx's Living Floor Fire Down" {
    state Idle {
        on player_within(20) -> Toss
    }
    state Toss {
        toss_object("Quiet Bomb", 10, cooldown: 1000)
        on no_player_within(21) -> Idle
        on player_within(5, "Shoot and Toss") -> Shoot_and_Toss
    }
    state Shoot_and_Toss {
        on no_player_within(21) -> Idle
        on no_player_within(6) -> Toss
        shoot(0, 18, fixed_angle: 0)
        toss_object("Quiet Bomb", 10, cooldown: 1000)
    }
}

enemy "Oryx Knight" {
    state waiting_for_u_bae__3 {
        on player_within(10, "tim 4 rekkings") -> tim_4_rekkings
    }
    state tim_4_rekkings {
        prioritize() {
            wander(0.2)
            follow(0.6, 10, 3, -1, 0)
        }
        shoot(10, 3, 20, 0, cooldown: 350)
        on timed(5000, "tim 4 singular rekt") -> tim_4_singular_rekt
    }
    state tim_4_singular_rekt {
        prioritize() {
            wander(0.2)
            follow(0.7, 10, 3, -1, 0)
        }
        shoot(10, 1, projectile: 0, cooldown: 50)
        shoot(10, 1, projectile: 1, cooldown: 1000)
        shoot(10, 1, projectile: 2, cooldown: 450)
        on timed(2500, "tim 4 rekkings") -> tim_4_rekkings
    }
}

enemy "Oryx Pet" {
    state swagoo_baboon {
        on player_within(10) -> anuspiddle
    }
    state anuspiddle {
        prioritize() {
            wander(0.2)
            follow(0.6, 10, 0, -1, 0)
        }
        shoot(10, 2, shoot_angle: 20, projectile: 0, cooldown: 1)
        shoot(10, 1, projectile: 0, cooldown: 1)
    }
}

enemy "Oryx Insect Commander" {
    state lol_jordan_is_a_nub {
        prioritize() {
            wander(0.2)
        }
        reproduce("Oryx Insect Minion", 10, 20, 1)
        shoot(10, 1, projectile: 0, cooldown: 900)
    }
}

enemy "Oryx Insect Minion" {
    state its_SWARMING_time {
        prioritize() {
            wander(0.2)
            stay_close_to_spawn(0.4, 8)
            follow(0.8, 10, 1, -1, 0)
        }
        shoot(10, 5, projectile: 0, cooldown: 1500)
        shoot(10, 1, projectile: 0, cooldown: 230)
    }
}

enemy "Oryx Suit of Armor" {
    state idle {
        on player_within(8, "attack me pl0x") -> attack_me_pl0x
    }
    state attack_me_pl0x {
        on damage_taken(1, "jordan is stanking") -> jordan_is_stanking
    }
    state jordan_is_stanking {
        prioritize() {
            wander(0.2)
            follow(0.4, 10, 2, -1, 0)
        }
        set_alt_texture(1)
        shoot(10, 2, 15, 0, cooldown: 600)
        on hp_below(0.2) -> heal
    }
    state heal {
        conditional_effect(invulnerable)
        set_alt_texture(0)
        shoot(10, 6, projectile: 0, cooldown: 200)
        heal_self(cooldown: 2000, amount: 200)
        on timed(1500, "jordan is stanking") -> jordan_is_stanking
    }
}

enemy "Oryx Eye Warrior" {
    state swaggin {
        on player_within(10) -> penispiddle
    }
    state penispiddle {
        prioritize() {
            follow(0.6, 10, 0, -1, 0)
        }
        shoot(10, 5, projectile: 0, cooldown: 1000)
        shoot(10, 1, projectile: 1, cooldown: 500)
    }
}

enemy "Oryx Brute" {
    state swaggin {
        on player_within(10) -> piddle
    }
    state piddle {
        prioritize() {
            wander(0.2)
            follow(0.4, 10, 1, -1, 0)
        }
        shoot(10, 5, projectile: 1, cooldown: 1000)
        reproduce("Oryx Eye Warrior", 10, 4, 2)
        on timed(5000) -> charge
    }
    state charge {
        prioritize() {
            wander(0.3)
            follow(1.2, 10, 1, -1, 0)
        }
        shoot(10, 5, projectile: 1, cooldown: 1000)
        shoot(10, 5, projectile: 2, cooldown: 750)
        reproduce("Oryx Eye Warrior", 10, 4, 2)
        shoot(10, 3, 10, projectile: 0, cooldown: 300)
        on timed(4000) -> piddle
    }
}

enemy "Quiet Bomb" {
    conditional_effect(invincible, true)
    state Idle {
        state Tex1 {
            on timed(250) -> Tex2
        }
        state Tex2 {
            set_alt_texture(1)
            on timed(250) -> Tex3
        }
        state Tex3 {
            set_alt_texture(0)
            on timed(250) -> Tex4
        }
        state Tex4 {
            set_alt_texture(1)
            on timed(250) -> Explode
        }
    }
    state Explode {
        set_alt_texture(0)
        shoot(0, 18, fixed_angle: 0)
        suicide()
    }
}

