enemy "Oryx Stone Guardian Right" {
    state Idle {
        conditional_effect(invulnerable, true)
        on player_within(2) -> Order
    }
    state Order {
        order(10, "Oryx Stone Guardian Left", "Start")
        on timed(0) -> Start
    }
    state Start {
        conditional_effect(invulnerable)
        flash(12632256, 0.5, 3)
        on timed(1500, "Lets go") -> Lets_go
    }
    state Together_is_better {
        on entity_not_exists("Oryx Stone Guardian Left", 100, "Forever Alone") -> Forever_Alone
        state Lets_go {
            on timed(10000) -> Circle
            state Imma_Follow {
                follow(1, 2, 0.3)
                shoot(5, 5, shoot_angle: 5, cooldown: 1000)
                on timed(5000, "Imma chill") -> Imma_chill
            }
            state Imma_chill {
                prioritize() {
                    stay_close_to_spawn(0.5, 3)
                    wander(0.5)
                }
                shoot(0, 10, projectile: 2, fixed_angle: 0, cooldown: 1000)
                on timed(5000, "Imma Follow") -> Imma_Follow
            }
        }
        state Circle {
            state Prepare {
                move_to(speed: 1, x: 127.5, y: 39.5)
                on entity_exists("Oryx Stone Guardian Left", 1) -> Prepare2
            }
            state Prepare2 {
                move_to(speed: 1, x: 130.5, y: 39.5)
                on timed(1000) -> PrepareEnd
            }
            state PrepareEnd {
                orbit(1, 5, target: "Oryx Guardian TaskMaster")
                state cpe_1 {
                    shoot(0, 2, fixed_angle: 0, projectile: 1)
                    on timed(200) -> cpe_2
                }
                state cpe_2 {
                    shoot(0, 2, fixed_angle: 36, projectile: 1)
                    on timed(200) -> cpe_3
                }
                state cpe_3 {
                    shoot(0, 2, fixed_angle: 72, projectile: 1)
                    on timed(200) -> cpe_4
                }
                state cpe_4 {
                    shoot(0, 2, fixed_angle: 108, projectile: 1)
                    on timed(200) -> cpe_5
                }
                state cpe_5 {
                    shoot(0, 2, fixed_angle: 144, projectile: 1)
                    on timed(200) -> cpe_6
                }
                state cpe_6 {
                    shoot(0, 2, fixed_angle: 180, projectile: 1)
                    on timed(200) -> cpe_7
                }
                state cpe_7 {
                    shoot(0, 2, fixed_angle: 216, projectile: 1)
                    on timed(200) -> cpe_8
                }
                state cpe_8 {
                    shoot(0, 2, fixed_angle: 252, projectile: 1)
                    on timed(200) -> cpe_9
                }
                state cpe_9 {
                    shoot(0, 2, fixed_angle: 288, projectile: 1)
                    on timed(200) -> cpe_10
                }
                state cpe_10 {
                    shoot(0, 2, fixed_angle: 324, projectile: 1)
                    on timed(200) -> checkEntities
                }
                state checkEntities {
                    on player_within(3, "cpe_Imma Follow") -> cpe_Imma_Follow
                    on no_player_within(3, "cpe_Imma chill") -> cpe_Imma_chill
                }
                state cpe_x {
                    on timed(5000, "Move Sideways") -> Move_Sideways
                    state cpe_Imma_Follow {
                        follow(1, 3, 0.3)
                        shoot(5, 5, cooldown: 1000)
                        on timed(2500, "cpe_Imma chill") -> cpe_Imma_chill
                    }
                    state cpe_Imma_chill {
                        prioritize() {
                            stay_close_to_spawn(0.5, 3)
                            wander(0.5)
                        }
                        shoot(0, 10, projectile: 2, fixed_angle: 0, cooldown: 1000)
                        on timed(2500, "cpe_Imma Follow") -> cpe_Imma_Follow
                    }
                }
            }
        }
        state Move_Sideways {
            state msw_prepare {
                move_to(speed: 1, x: 141.5, y: 39.5)
                on timed(1500) -> msw_shoot
            }
            state msw_shoot {
                shoot(0, 2, fixed_angle: 90, cooldown_offset: 0)
                shoot(0, 2, fixed_angle: 85.5, cooldown_offset: 100)
                shoot(0, 2, fixed_angle: 81, cooldown_offset: 200)
                shoot(0, 2, fixed_angle: 76.5, cooldown_offset: 300)
                shoot(0, 2, fixed_angle: 72, cooldown_offset: 400)
                shoot(0, 2, fixed_angle: 67.5, cooldown_offset: 500)
                shoot(0, 2, fixed_angle: 63, cooldown_offset: 600)
                shoot(0, 2, fixed_angle: 58.5, cooldown_offset: 700)
                shoot(0, 2, fixed_angle: 54, cooldown_offset: 800)
                shoot(0, 2, fixed_angle: 49.5, cooldown_offset: 900)
                shoot(0, 2, fixed_angle: 45, cooldown_offset: 1000)
                shoot(0, 2, fixed_angle: 40.5, cooldown_offset: 1100)
                shoot(0, 2, fixed_angle: 36, cooldown_offset: 1200)
                shoot(0, 2, fixed_angle: 31.5, cooldown_offset: 1300)
                shoot(0, 2, fixed_angle: 27, cooldown_offset: 1400)
                shoot(0, 2, fixed_angle: 22.5, cooldown_offset: 1500)
                shoot(0, 2, fixed_angle: 18, cooldown_offset: 1600)
                shoot(0, 2, fixed_angle: 13.5, cooldown_offset: 1700)
                shoot(0, 2, fixed_angle: 9, cooldown_offset: 1800)
                shoot(0, 2, fixed_angle: 4.5, cooldown_offset: 1900)
            }
        }
    }
    state Forever_Alone {
    }
    loot {
        threshold
    }
}

