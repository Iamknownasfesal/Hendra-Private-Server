enemy "Rock Bot" {
    spawn("Paper Bot", max_children: 1, initial_spawn: 1, cooldown: 10000, gives_no_xp: false)
    spawn("Steel Bot", max_children: 1, initial_spawn: 1, cooldown: 10000, gives_no_xp: false)
    swirl(speed: 0.6, radius: 3, targeted: false)
    state Waiting {
        on player_within(15) -> Attacking
    }
    state Attacking {
        shoot(8, cooldown: 2000)
        heal_group(8, "Papers", cooldown: 1000)
        taunt(0.5, "We are impervious to non-mystic attacks!")
        on timed(10000) -> Waiting
    }
    loot {
        threshold
        threshold
    }
}

enemy "Paper Bot" {
    drop_portal_on_death("Puppet Theatre Portal", 0.15)
    prioritize() {
        orbit(0.4, 3, target: "Rock Bot")
        wander(0.8)
    }
    state Idle {
        on player_within(15) -> Attack
    }
    state Attack {
        shoot(8, count: 3, shoot_angle: 20, cooldown: 800)
        heal_group(8, "Steels", cooldown: 1000)
        on no_player_within(30) -> Idle
        on hp_below(0.2) -> Explode
    }
    state Explode {
        shoot(0, count: 10, shoot_angle: 36, fixed_angle: 0)
        decay(0)
    }
    loot {
        threshold
        threshold
    }
}

enemy "Steel Bot" {
    prioritize() {
        orbit(0.4, 3, target: "Rock Bot")
        wander(0.8)
    }
    state Idle {
        on player_within(15) -> Attack
    }
    state Attack {
        shoot(8, count: 3, shoot_angle: 20, cooldown: 800)
        heal_group(8, "Rocks", cooldown: 1000)
        taunt(0.5, "Silly squishy. We heal our brothers in a circle.")
        on no_player_within(30) -> Idle
        on hp_below(0.2) -> Explode
    }
    state Explode {
        shoot(0, count: 10, shoot_angle: 36, fixed_angle: 0)
        decay(0)
    }
    loot {
        threshold
        threshold
    }
}

enemy "Djinn" {
    state Idle {
        prioritize() {
            stay_above(1, 200)
            wander(0.8)
        }
        conditional_effect(invulnerable)
        reproduce(density_max: 3, density_radius: 20)
        on player_within(8) -> Attacking
    }
    state Attacking {
        state Bullet {
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 0, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 100, cooldown_offset: 200, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 110, cooldown_offset: 400, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 120, cooldown_offset: 600, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 130, cooldown_offset: 800, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 140, cooldown_offset: 1000, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 150, cooldown_offset: 1200, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 160, cooldown_offset: 1400, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 170, cooldown_offset: 1600, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 180, cooldown_offset: 1800, shoot_angle: 90)
            shoot(1, count: 8, cooldown: 10000, fixed_angle: 180, cooldown_offset: 2000, shoot_angle: 45)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 180, cooldown_offset: 0, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 170, cooldown_offset: 200, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 160, cooldown_offset: 400, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 150, cooldown_offset: 600, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 140, cooldown_offset: 800, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 130, cooldown_offset: 1000, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 120, cooldown_offset: 1200, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 110, cooldown_offset: 1400, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 100, cooldown_offset: 1600, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 1800, shoot_angle: 90)
            shoot(1, count: 4, cooldown: 10000, fixed_angle: 90, cooldown_offset: 2000, shoot_angle: 22.5)
            on timed(2000) -> Wait
        }
        state Wait {
            follow(0.7, range: 0.5)
            flash(4278255360, 0.1, 20)
            conditional_effect(invulnerable)
            on timed(2000) -> Bullet
        }
        on no_player_within(13) -> Idle
        on hp_below(0.5) -> FlashBeforeExplode
    }
    state FlashBeforeExplode {
        conditional_effect(invulnerable)
        flash(16711680, 0.3, 3)
        on timed(1000) -> Explode
    }
    state Explode {
        shoot(0, count: 10, shoot_angle: 36, fixed_angle: 0)
        suicide()
    }
    loot {
        threshold
        threshold
    }
}

enemy "Leviathan" {
    state Wander {
        swirl()
        shoot(10, 2, 10, 1, cooldown: 500)
        on timed(5000) -> Triangle
    }
    state Triangle {
        state s1 {
            move_line(0.7, 40)
            shoot(1, 3, 120, fixed_angle: 34, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 38, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 42, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 46, cooldown: 300)
            on timed(1500, "2") -> s2
        }
        state s2 {
            move_line(0.7, 160)
            shoot(1, 3, 120, fixed_angle: 94, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 98, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 102, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 106, cooldown: 300)
            on timed(1500, "3") -> s3
        }
        state s3 {
            move_line(0.7, 280)
            shoot(1, 3, 120, fixed_angle: 274, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 278, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 282, cooldown: 300)
            shoot(1, 3, 120, fixed_angle: 286, cooldown: 300)
            on timed(1500) -> Wander
        }
    }
    loot {
        threshold
    }
}

