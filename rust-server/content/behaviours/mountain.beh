enemy "Arena Horseman Anchor" {
    conditional_effect(invincible)
}

enemy "Arena Headless Horseman" {
    spawn("Arena Horseman Anchor", 1, 1)
    state EverythingIsCool {
        on hp_below(0.1) -> End
        state Circle {
            shoot(15, 3, shoot_angle: 25, projectile: 0, cooldown: 1000)
            shoot(15, projectile: 1, cooldown: 1000)
            orbit(1, 5, 10, "Arena Horseman Anchor")
            on timed(8000) -> Shoot
        }
        state Shoot {
            return_to_spawn(1.5)
            conditional_effect(invincible)
            flash(15787660, 1, 6)
            shoot(15, 8, projectile: 2, cooldown: 1500)
            shoot(15, projectile: 1, cooldown: 2500)
            on timed(6000) -> Circle
        }
    }
    state End {
        prioritize() {
            follow(1.5, 20, 1)
            wander(1.5)
        }
        flash(15787660, 1, 1000)
        shoot(15, 3, shoot_angle: 25, projectile: 0, cooldown: 1000)
        shoot(15, projectile: 1, cooldown: 1000)
    }
    drop_portal_on_death("Haunted Cemetery Portal", 0.4)
}

enemy "White Demon" {
    drop_portal_on_death("Abyss of Demons Portal", 0.17)
    prioritize() {
        stay_above(1, 200)
        follow(1, range: 7)
        wander(0.4)
    }
    shoot(10, count: 3, shoot_angle: 20, predictive: 1, cooldown: 500)
    reproduce(density_max: 3)
    loot {
        threshold
        threshold
    }
}

