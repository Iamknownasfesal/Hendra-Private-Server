enemy "Encore Huntress Statue" {
    state s1 {
        conditional_effect(invincible)
    }
    state s2 {
        flash(16776960, 2, 5)
        move_to2(9.5, 16.5, 0.1, true, true, false)
        on timed(2000, "3") -> s3
    }
    state s3 {
        transform_on_death("Encore Huntress")
        suicide()
    }
}

