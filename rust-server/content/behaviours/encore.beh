enemy "HomingFire" {
    conditional_effect(invincible, true)
    state idle {
        follow(0.8, 50, 5)
        on timed(2200) -> white
    }
    state white {
        flash(16777215, 1, 1)
        on timed(500) -> shoot
    }
    state shoot {
        shoot(50, 1, 0, 0)
        suicide()
    }
}

