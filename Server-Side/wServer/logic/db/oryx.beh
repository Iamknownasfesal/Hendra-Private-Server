enemy "Oryx the Mad God 1" {
    drop_portal_on_death("Wine Cellar Portal", 100, timeout: 120)
    on hp_below(0.2) -> rage
    state Slow {
        taunt("Fools! I still have {HP} hitpoints!")
        spawn("Minion of Oryx", 5, 0, 350000)
        reproduce("Minion of Oryx", 10, 5, 1500)
        shoot(25, 4, 10, 4, cooldown: 1000)
        on timed(20000, "Dance 1") -> Dance_1
    }
    state Dance_1 {
        flash(255368723, 0.5, 60)
        taunt("BE SILENT!!!")
        conditional_effect(invulnerable)
        shoot(50, 8, projectile: 6, cooldown: 700, cooldown_offset: 200)
        toss_object("Ring Element", 9, 24, 320000)
        toss_object("Ring Element", 9, 48, 320000)
        toss_object("Ring Element", 9, 72, 320000)
        toss_object("Ring Element", 9, 96, 320000)
        toss_object("Ring Element", 9, 120, 320000)
        toss_object("Ring Element", 9, 144, 320000)
        toss_object("Ring Element", 9, 168, 320000)
        toss_object("Ring Element", 9, 192, 320000)
        toss_object("Ring Element", 9, 216, 320000)
        toss_object("Ring Element", 9, 240, 320000)
        toss_object("Ring Element", 9, 264, 320000)
        toss_object("Ring Element", 9, 288, 320000)
        toss_object("Ring Element", 9, 312, 320000)
        toss_object("Ring Element", 9, 336, 320000)
        toss_object("Ring Element", 9, 360, 320000)
        conditional_effect(invulnerable)
        on timed(25000) -> artifacts
    }
    state artifacts {
        taunt("My Artifacts will protect me!")
        flash(255368723, 0.5, 60)
        shoot(50, 3, projectile: 9, cooldown: 1500, cooldown_offset: 200)
        shoot(50, 10, projectile: 8, cooldown: 2000, cooldown_offset: 200)
        shoot(50, 10, projectile: 7, cooldown: 500, cooldown_offset: 200)
        toss_object("Guardian Element 1", 1, 0, 90000001, 1000)
        toss_object("Guardian Element 1", 1, 90, 90000001, 1000)
        toss_object("Guardian Element 1", 1, 180, 90000001, 1000)
        toss_object("Guardian Element 1", 1, 270, 90000001, 1000)
        toss_object("Guardian Element 2", 9, 0, 90000001, 1000)
        toss_object("Guardian Element 2", 9, 90, 90000001, 1000)
        toss_object("Guardian Element 2", 9, 180, 90000001, 1000)
        toss_object("Guardian Element 2", 9, 270, 90000001, 1000)
        on timed(25000) -> gaze
    }
    state gaze {
        taunt("All who looks upon my face shall die.")
        shoot(count: 2, cooldown: 1000, projectile: 1, radius: 7, shoot_angle: 10, cooldown_offset: 800)
        on timed(10000, "Dance 2") -> Dance_2
    }
    state Dance_2 {
        flash(255368723, 0.5, 60)
        taunt("Time for more dancing!")
        shoot(50, 8, projectile: 6, cooldown: 700, cooldown_offset: 200)
        toss_object("Ring Element", 9, 24, 320000)
        toss_object("Ring Element", 9, 48, 320000)
        toss_object("Ring Element", 9, 72, 320000)
        toss_object("Ring Element", 9, 96, 320000)
        toss_object("Ring Element", 9, 120, 320000)
        toss_object("Ring Element", 9, 144, 320000)
        toss_object("Ring Element", 9, 168, 320000)
        toss_object("Ring Element", 9, 192, 320000)
        toss_object("Ring Element", 9, 216, 320000)
        toss_object("Ring Element", 9, 240, 320000)
        toss_object("Ring Element", 9, 264, 320000)
        toss_object("Ring Element", 9, 288, 320000)
        toss_object("Ring Element", 9, 312, 320000)
        toss_object("Ring Element", 9, 336, 320000)
        toss_object("Ring Element", 9, 360, 320000)
        on timed(1000, "Dance2, 1") -> Dance2__1
    }
    state Dance2__1 {
        conditional_effect(invulnerable)
        shoot(0, projectile: 8, count: 4, shoot_angle: 90, fixed_angle: 0, cooldown: 170)
        on timed(200, "Dance2, 2") -> Dance2__2
    }
    state Dance2__2 {
        conditional_effect(invulnerable)
        shoot(0, projectile: 8, count: 4, shoot_angle: 90, fixed_angle: 30, cooldown: 170)
        on timed(200, "Dance2, 3") -> Dance2__3
    }
    state Dance2__3 {
        conditional_effect(invulnerable)
        shoot(0, projectile: 8, count: 4, shoot_angle: 90, fixed_angle: 15, cooldown: 170)
        on timed(200, "Dance2, 4") -> Dance2__4
    }
    state Dance2__4 {
        shoot(0, projectile: 8, count: 4, shoot_angle: 90, fixed_angle: 45, cooldown: 170)
        on timed(200, "Dance2, 1") -> Dance2__1
    }
    state rage {
        change_size(10, 200)
        taunt(0.3, "I HAVE HAD ENOUGH OF YOU!!!", "ENOUGH!!!", "DIE!!!")
        spawn("Minion of Oryx", 10, 0, 350000)
        reproduce("Minion of Oryx", 10, 5, 1500)
        shoot(count: 2, cooldown: 1500, projectile: 1, radius: 7, shoot_angle: 10, cooldown_offset: 2000)
        shoot(count: 5, cooldown: 1500, projectile: 16, radius: 7, shoot_angle: 10, cooldown_offset: 2000)
        follow(0.85, range: 1, cooldown: 0)
        flash(268369920, 0.5, 9000001)
    }
    loot {
        threshold(0.05) {  }
        threshold(0.2) { item("Oryx's Arena Key", 0.005) }
        threshold(0.05) { item("Potion of Attack", 0.3) item("Potion of Defense", 0.3) item("The Zol Awakening (Token)", 0.001) item("Calling of the Titan (Token)", 0.001) }
        threshold(0.1) { tier(10, weapon, 0.07) tier(11, weapon, 0.06) tier(5, ability, 0.07) tier(11, armor, 0.07) tier(5, ring, 0.06) }
    }
}

enemy "Ring Element" {
    shoot(50, 12, projectile: 0, cooldown: 700, cooldown_offset: 200)
    conditional_effect(invulnerable)
    on timed(20000) -> Despawn
    state Despawn {
        suicide()
    }
}

enemy "Minion of Oryx" {
    wander(0.4)
    shoot(3, 3, 10, 0, cooldown: 1000)
    shoot(3, 3, projectile: 1, shoot_angle: 10, cooldown: 1000)
    loot {
        tier(7, weapon, 0.2)
        item("Magic Potion", 0.03)
    }
}

enemy "Guardian Element 1" {
    orbit(1, 1, target: "Oryx the Mad God 1", radius_variance: 0)
    conditional_effect(invulnerable)
    shoot(25, 3, 10, 0, cooldown: 1000)
    on timed(10000) -> Grow
    state Grow {
        change_size(100, 200)
        conditional_effect(invulnerable)
        orbit(1, 1, target: "Oryx the Mad God 1", radius_variance: 0)
        shoot(3, 1, 10, 0, cooldown: 700)
        on timed(10000) -> Despawn
    }
    state Despawn {
        conditional_effect(invulnerable)
        orbit(1, 1, target: "Oryx the Mad God 1", radius_variance: 0)
        change_size(100, 100)
        suicide()
    }
}

enemy "Guardian Element 2" {
