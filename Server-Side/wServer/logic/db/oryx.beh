enemy "Oryx the Mad God 2" {
    scale_h_p(50000)
    state Attack {
        wander(0.05)
        shoot(25, projectile: 0, count: 8, shoot_angle: 45, cooldown: 1500, cooldown_offset: 1500)
        shoot(25, projectile: 1, count: 3, shoot_angle: 10, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 2, count: 3, shoot_angle: 10, predictive: 0.2, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 3, count: 2, shoot_angle: 10, predictive: 0.4, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 4, count: 3, shoot_angle: 10, predictive: 0.6, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 5, count: 2, shoot_angle: 10, predictive: 0.8, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 6, count: 3, shoot_angle: 10, predictive: 1, cooldown: 1000, cooldown_offset: 1000)
        taunt(1, 6000, "Puny mortals! My {HP} HP will annihilate you!")
        spawn("Henchman of Oryx", 5, cooldown: 5000)
        on hp_below(0.2) -> prepareRage
    }
    state prepareRage {
        follow(0.1, 15, 3)
        taunt("Can't... keep... henchmen... alive... anymore! ARGHHH!!!")
        conditional_effect(invulnerable)
        shoot(25, 30, fixed_angle: 0, projectile: 7, cooldown: 4000, cooldown_offset: 4000)
        shoot(25, 30, fixed_angle: 30, projectile: 8, cooldown: 4000, cooldown_offset: 4000)
        on timed(10000) -> rage
    }
    state rage {
        follow(0.1, 15, 3)
        shoot(25, 30, projectile: 7, cooldown: 90000001, cooldown_offset: 8000)
        shoot(25, 30, projectile: 8, cooldown: 90000001, cooldown_offset: 8500)
        shoot(25, projectile: 0, count: 8, shoot_angle: 45, cooldown: 1500, cooldown_offset: 1500)
        shoot(25, projectile: 1, count: 3, shoot_angle: 10, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 2, count: 3, shoot_angle: 10, predictive: 0.2, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 3, count: 2, shoot_angle: 10, predictive: 0.4, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 4, count: 3, shoot_angle: 10, predictive: 0.6, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 5, count: 2, shoot_angle: 10, predictive: 0.8, cooldown: 1000, cooldown_offset: 1000)
        shoot(25, projectile: 6, count: 3, shoot_angle: 10, predictive: 1, cooldown: 1000, cooldown_offset: 1000)
        toss_object("Monstrosity Scarab", 7, 0, cooldown: 1000)
        taunt(1, 6000, "Puny mortals! My {HP} HP will annihilate you!")
    }
    loot {
        threshold(0.05) {  }
        threshold(0.05) {  }
        threshold(0.29) { item("Potion of Vitality", 1) }
        threshold(0.05) { item("Potion of Attack", 0.3) item("Potion of Defense", 0.3) item("Potion of Wisdom", 0.3) }
        threshold(0.2) { item("Oryx's Arena Key", 0.01) }
        threshold(0.1) { tier(10, weapon, 0.07) tier(11, weapon, 0.06) tier(12, weapon, 0.05) tier(5, ability, 0.07) tier(6, ability, 0.05) tier(11, armor, 0.07) tier(12, armor, 0.06) tier(13, armor, 0.05) tier(5, ring, 0.06) }
    }
}

