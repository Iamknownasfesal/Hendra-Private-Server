    conditional_effect(invulnerable)
    shoot(25, 3, 10, 0, cooldown: 1000)
    on timed(20000) -> Despawn
    state Despawn {
        suicide()
    }
}

enemy "Henchman of Oryx" {
    state Attack {
        prioritize() {
            orbit(0.2, 2, target: "Oryx the Mad God 2", radius_variance: 1)
            wander(0.3)
        }
        shoot(15, predictive: 1, cooldown: 2500)
        shoot(10, count: 3, shoot_angle: 10, projectile: 1, cooldown: 2500)
        spawn("Vintner of Oryx", max_children: 1, initial_spawn: 1, cooldown: 5000)
        spawn("Aberrant of Oryx", max_children: 1, initial_spawn: 1, cooldown: 5000)
        spawn("Monstrosity of Oryx", max_children: 1, initial_spawn: 1, cooldown: 5000)
        spawn("Abomination of Oryx", max_children: 1, initial_spawn: 1, cooldown: 5000)
    }
    state Suicide {
        decay(0)
    }
}

enemy "Monstrosity of Oryx" {
    state Wait {
        on player_within(15) -> Attack
    }
    state Attack {
        on timed(10000) -> Wait
        prioritize() {
            orbit(0.1, 6, target: "Oryx the Mad God 2", radius_variance: 3)
            follow(0.1, acquire_range: 15)
            wander(0.2)
        }
        toss_object("Monstrosity Scarab", cooldown: 10000, range: 1, angle: 0, cooldown_offset: 1000)
    }
}

enemy "Monstrosity Scarab" {
    state Attack {
        state Charge {
            prioritize() {
                charge(range: 25, cooldown: 1000)
                wander(0.3)
            }
            on player_within(1) -> Boom
        }
        state Boom {
            shoot(1, count: 16, shoot_angle: 360, fixed_angle: 0)
            decay(0)
        }
    }
}

enemy "Vintner of Oryx" {
    state Attack {
        prioritize() {
            protect(1, "Oryx the Mad God 2", protection_range: 4, reprotect_range: 3)
            charge(speed: 1, range: 15, cooldown: 2000)
            protect(1, "Henchman of Oryx")
            stay_back(1, 15)
            wander(1)
        }
        shoot(10, cooldown: 250)
    }
}

enemy "Aberrant of Oryx" {
    prioritize() {
        protect(0.2, "Oryx the Mad God 2")
        wander(0.7)
    }
    state Wait {
        on player_within(15) -> Attack
    }
    state Attack {
        on timed(10000) -> Wait
        state Randomize {
            on timed(100, randomized: true) -> Toss1
            on timed(100, randomized: true) -> Toss2
            on timed(100, randomized: true) -> Toss3
            on timed(100, randomized: true) -> Toss4
            on timed(100, randomized: true) -> Toss5
            on timed(100, randomized: true) -> Toss6
            on timed(100, randomized: true) -> Toss7
            on timed(100, randomized: true) -> Toss8
        }
        state Toss1 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 0)
            on timed(4900) -> Randomize
        }
        state Toss2 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 45)
            on timed(4900) -> Randomize
        }
        state Toss3 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 90)
            on timed(4900) -> Randomize
        }
        state Toss4 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 135)
            on timed(4900) -> Randomize
        }
        state Toss5 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 180)
            on timed(4900) -> Randomize
        }
        state Toss6 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 225)
            on timed(4900) -> Randomize
        }
        state Toss7 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 270)
            on timed(4900) -> Randomize
        }
        state Toss8 {
            toss_object("Aberrant Blaster", cooldown: 40000, range: 5, angle: 315)
            on timed(4900) -> Randomize
        }
    }
}

enemy "Aberrant Blaster" {
    state Wait {
        on player_within(3) -> Boom
    }
    state Boom {
        shoot(10, count: 5, shoot_angle: 7)
        decay(0)
    }
}

enemy "Bile of Oryx" {
    prioritize() {
        protect(0.4, "Oryx the Mad God 2", protection_range: 5, reprotect_range: 4)
        wander(0.5)
    }
}

enemy "Abomination of Oryx" {
    state Shoot {
        shoot(1, 3, shoot_angle: 5, projectile: 0)
        shoot(1, 5, shoot_angle: 5, projectile: 1)
        shoot(1, 7, shoot_angle: 5, projectile: 2)
        shoot(1, 5, shoot_angle: 5, projectile: 3)
        shoot(1, 3, shoot_angle: 5, projectile: 4)
        on timed(1000) -> Wait
    }
    state Wait {
        on player_within(2) -> Shoot
    }
    prioritize() {
        charge(3, 10, 3000)
        wander(0.5)
    }
}

