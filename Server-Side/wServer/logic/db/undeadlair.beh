enemy "Septavius the Ghost God" {
    on player_within(8) -> transition1
    conditional_effect(invulnerable)
    flash(65280, 0.25, 12)
    wander(0.1)
    state transition1 {
        on timed(3000) -> spiral
    }
    state transition2 {
        on timed(3000) -> ring
    }
    state transition3 {
        on timed(3000) -> quiet
    }
    state transition4 {
        on timed(3000) -> spawn
    }
    state spiral {
        spawn("Lair Ghost Archer", 1, 1)
        spawn("Lair Ghost Knight", 2, 2)
        spawn("Lair Ghost Mage", 1, 1)
        spawn("Lair Ghost Rogue", 2, 2)
        spawn("Lair Ghost Paladin", 1, 1)
        spawn("Lair Ghost Warrior", 2, 2)
        shoot(10, 3, fixed_angle: 0, cooldown_offset: 0, cooldown: 1000)
        shoot(10, 3, fixed_angle: 24, cooldown_offset: 200, cooldown: 1000)
        shoot(10, 3, fixed_angle: 48, cooldown_offset: 400, cooldown: 1000)
        shoot(10, 3, fixed_angle: 72, cooldown_offset: 600, cooldown: 1000)
        shoot(10, 3, fixed_angle: 96, cooldown_offset: 800, cooldown: 1000)
        on timed(10000) -> transition2
    }
    state ring {
        wander(0.1)
        shoot(10, 12, projectile: 4, cooldown: 2000)
        on timed(10000) -> transition3
    }
    state quiet {
        wander(0.1)
        shoot(10, 8, projectile: 1, cooldown: 1000)
        shoot(10, 8, projectile: 1, cooldown_offset: 500, angle_offset: 22.5, cooldown: 1000)
        shoot(8, 3, shoot_angle: 20, projectile: 2, cooldown: 2000)
        on timed(10000) -> transition4
    }
    state spawn {
        wander(0.1)
        spawn("Ghost Mage of Septavius", 2, 2)
        spawn("Ghost Rogue of Septavius", 2, 2)
        spawn("Ghost Warrior of Septavius", 2, 2)
        reproduce("Ghost Mage of Septavius", density_max: 2, cooldown: 1000)
        reproduce("Ghost Rogue of Septavius", density_max: 2, cooldown: 1000)
        reproduce("Ghost Warrior of Septavius", density_max: 2, cooldown: 1000)
        shoot(8, 3, shoot_angle: 10, projectile: 1, cooldown: 1000)
        on timed(10000) -> transition1
    }
    loot {
        threshold(0.32) { item("Potion of Wisdom", 1) }
        threshold(0.1) { item("Doom Bow", 0.012) item("Wine Cellar Incantation", 0.005) tier(3, ring, 0.2) tier(4, ring, 0.1) tier(7, weapon, 0.2) tier(8, weapon, 0.1) tier(3, ability, 0.2) tier(4, ability, 0.15) tier(5, ability, 0.1) }
        threshold(0.2) {  }
    }
}

