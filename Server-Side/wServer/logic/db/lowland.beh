enemy "Giant Crab" {
    state idle {
        prioritize() {
            stay_above(0.6, 13)
            wander(0.6)
        }
        on player_within(11) -> scuttle
    }
    state scuttle {
        shoot(9, projectile: 0, cooldown: 1000)
        shoot(9, projectile: 1, cooldown: 1000)
        shoot(9, projectile: 2, cooldown: 1000)
        shoot(9, projectile: 3, cooldown: 1000)
        state move_2 {
            prioritize() {
                follow(1, acquire_range: 10.6, range: 2)
                stay_above(1, 25)
                wander(0.6)
            }
            on timed(400) -> pause
        }
        state pause_2 {
            on timed(200) -> move
        }
        on timed(4700, "tri-spit") -> tri_spit
    }
    state tri_spit {
        shoot(9, projectile: 4, predictive: 0.5, cooldown_offset: 1200, cooldown: 90000)
        shoot(9, projectile: 4, predictive: 0.5, cooldown_offset: 1800, cooldown: 90000)
        shoot(9, projectile: 4, predictive: 0.5, cooldown_offset: 2400, cooldown: 90000)
        state move {
            prioritize() {
                follow(1, acquire_range: 10.6, range: 2)
                stay_above(1, 25)
                wander(0.6)
            }
            on timed(400) -> pause
        }
        state pause {
            on timed(200) -> move
        }
        on timed(3200) -> idle
    }
    drop_portal_on_death("Pirate Cave Portal", 0.01)
    loot {
        tier(2, weapon, 0.14)
        tier(2, armor, 0.19)
        tier(1, ring, 0.05)
        tier(1, ability, 0.28)
        item("Health Potion", 0.02)
        item("Magic Potion", 0.02)
    }
}

