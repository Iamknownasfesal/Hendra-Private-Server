enemy "Sumo Master" {
    state sleeping1 {
        set_alt_texture(0)
        on timed(1000) -> sleeping2
        on hp_below(0.99) -> hurt
    }
    state sleeping2 {
        set_alt_texture(3)
        on timed(1000) -> sleeping1
        on hp_below(0.99) -> hurt
    }
    state hurt {
        set_alt_texture(2)
        spawn("Lil Sumo", cooldown: 200)
        on timed(1000) -> awake
    }
    state awake {
        set_alt_texture(1)
        shoot(3, cooldown: 250)
        prioritize() {
            follow(0.05, range: 1)
            wander(0.05)
        }
        on hp_below(0.5) -> rage
    }
    state rage {
        set_alt_texture(4)
        taunt("Engaging Super-Mode!!!")
        prioritize() {
            follow(0.6, range: 1)
            wander(0.6)
        }
        state shoot {
            shoot(8, projectile: 1, cooldown: 150)
            on timed(700) -> rest
        }
        state rest {
            on timed(400) -> shoot
        }
    }
    loot {
        item("Health Potion", 0.05)
        item("Magic Potion", 0.05)
    }
}

enemy "Lil Sumo" {
    shoot(8)
    prioritize() {
        orbit(0.4, 2, target: "Sumo Master")
        wander(0.4)
    }
    loot {
        item("Health Potion", 0.02)
        item("Magic Potion", 0.02)
    }
}

enemy "Elf Wizard" {
    state idle {
        wander(0.4)
        on player_within(11) -> move1
    }
    state move1 {
        shoot(10, count: 3, shoot_angle: 14, predictive: 0.3)
        prioritize() {
            stay_above(0.4, 14)
            back_and_forth(0.8)
        }
        on timed(2000) -> move2
    }
    state move2 {
        shoot(10, count: 3, shoot_angle: 10, predictive: 0.5)
        prioritize() {
            stay_above(0.4, 14)
            follow(0.6, acquire_range: 10.5, range: 3)
            wander(0.4)
        }
        on timed(2000) -> move3
    }
    state move3 {
        prioritize() {
            stay_above(0.4, 14)
            stay_back(0.6, distance: 5)
            wander(0.4)
        }
        on timed(2000) -> idle
    }
    spawn("Elf Archer", max_children: 2, cooldown: 15000, gives_no_xp: false)
    spawn("Elf Swordsman", max_children: 4, cooldown: 7000, gives_no_xp: false)
    spawn("Elf Mage", max_children: 1, cooldown: 8000, gives_no_xp: false)
    loot {
        tier(2, weapon, 0.36)
        tier(2, armor, 0.36)
        tier(1, ring, 0.11)
        tier(1, ability, 0.39)
        item("Health Potion", 0.02)
        item("Magic Potion", 0.02)
    }
}

