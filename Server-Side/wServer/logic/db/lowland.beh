enemy "Hobbit Mage" {
    state idle {
        on player_within(12) -> ring1
    }
    state ring1 {
        shoot(1, fixed_angle: 0, count: 15, shoot_angle: 24, cooldown: 1200, projectile: 0)
        on timed(400) -> ring2
    }
    state ring2 {
        shoot(1, fixed_angle: 8, count: 15, shoot_angle: 24, cooldown: 1200, projectile: 1)
        on timed(400) -> ring3
    }
    state ring3 {
        shoot(1, fixed_angle: 16, count: 15, shoot_angle: 24, cooldown: 1200, projectile: 2)
        on timed(400) -> idle
    }
    prioritize() {
        stay_above(0.4, 9)
        follow(0.75, range: 6)
        wander(0.4)
    }
    spawn("Hobbit Archer", max_children: 4, cooldown: 12000, gives_no_xp: false)
    spawn("Hobbit Rogue", max_children: 3, cooldown: 6000, gives_no_xp: false)
    loot {
        tier(2, weapon, 0.3)
        tier(2, armor, 0.3)
        tier(1, ring, 0.11)
        tier(1, ability, 0.39)
        item("Health Potion", 0.02)
        item("Magic Potion", 0.02)
    }
}

enemy "Hobbit Archer" {
    shoot(10)
    state run1 {
        prioritize() {
            protect(1.1, "Hobbit Mage", acquire_range: 12, protection_range: 10, reprotect_range: 1)
            wander(0.4)
        }
        on timed(400) -> run2
    }
    state run2 {
        prioritize() {
            stay_back(0.8, 4)
            wander(0.4)
        }
        on timed(600) -> run3
    }
    state run3 {
        prioritize() {
            protect(1, "Hobbit Archer", acquire_range: 16, protection_range: 2, reprotect_range: 2)
            wander(0.4)
        }
        on timed(400) -> run1
    }
    loot {
        item("Health Potion", 0.04)
    }
}

