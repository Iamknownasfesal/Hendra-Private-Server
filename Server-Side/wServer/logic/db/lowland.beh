enemy "Goblin Mage" {
    state unharmed {
        shoot(8, projectile: 0, predictive: 0.35, cooldown: 1000)
        shoot(8, projectile: 1, predictive: 0.35, cooldown: 1300)
        prioritize() {
            stay_above(0.4, 16)
            follow(0.5, acquire_range: 10.5, range: 4)
            wander(0.4)
        }
        on hp_below(0.65) -> activate_horde
    }
    state activate_horde {
        shoot(8, projectile: 0, predictive: 0.25, cooldown: 1000)
        shoot(8, projectile: 1, predictive: 0.25, cooldown: 1000)
        flash(4282927176, 0.6, 5000)
        order(12, "Goblin Rogue", "help")
        order(12, "Goblin Warrior", "help")
        prioritize() {
            stay_above(0.4, 16)
            stay_back(0.5, distance: 6)
        }
    }
    spawn("Goblin Rogue", max_children: 7, cooldown: 12000, gives_no_xp: false)
    spawn("Goblin Warrior", max_children: 7, cooldown: 12000, gives_no_xp: false)
    loot {
        tier(3, weapon, 0.3)
        tier(3, armor, 0.3)
        tier(1, ring, 0.09)
        tier(1, ability, 0.38)
        item("Health Potion", 0.02)
        item("Magic Potion", 0.02)
    }
}

