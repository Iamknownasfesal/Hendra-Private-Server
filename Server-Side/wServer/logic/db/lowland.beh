enemy "Goblin Rogue" {
    state protect {
        protect(0.8, "Goblin Mage", acquire_range: 12, protection_range: 1.5, reprotect_range: 1.5)
        on timed(1200, randomized: true) -> scatter
    }
    state scatter {
        orbit(0.8, 7, target: "Goblin Mage", radius_variance: 1)
        on timed(2400) -> protect
    }
    shoot(3)
    state help {
        protect(0.8, "Goblin Mage", acquire_range: 12, protection_range: 6, reprotect_range: 3)
        follow(0.8, acquire_range: 10.5, range: 1.5)
        on entity_not_exists("Goblin Mage", 15) -> protect
    }
    loot {
        item("Health Potion", 0.04)
    }
}

