enemy "Inactive Sarcophagus" {
    conditional_effect(invulnerable)
    on entity_not_exists("Beam Priestess", 14) -> checkPriest
    on entity_not_exists("Beam Priest", 1000) -> checkPriestess
    state checkPriest {
        conditional_effect(invulnerable)
        on entity_not_exists("Beam Priest", 1000) -> activate
    }
    state checkPriestess {
        conditional_effect(invulnerable)
        on entity_not_exists("Beam Priestess", 1000) -> activate
    }
    state activate {
        transform("Active Sarcophagus")
    }
}

enemy "Scarab" {
    on no_player_within(7) -> Idle
    on player_within(7) -> Chase
    state Idle {
        wander(0.1)
    }
    state Chase {
        follow(1.5, 7, 0)
        shoot(3, projectile: 1, cooldown: 500)
    }
}

enemy "Active Sarcophagus" {
    on hp_below(60) -> stun
    state stun {
        shoot(50, 8, 10, 0, cooldown: 9999999, cooldown_offset: 500)
        shoot(50, 8, 10, 0, cooldown: 9999999, cooldown_offset: 1000)
        shoot(50, 8, 10, 0, cooldown: 9999999, cooldown_offset: 1500)
        on timed(1500) -> idle
    }
    state idle {
        change_size(100, 100)
    }
    loot {
        item("Magic Potion", 0.002)
        item("Health Potion", 0.15)
        threshold(0.32) { item("Tincture of Mana", 0.15) item("Tincture of Dexterity", 0.15) item("Tincture of Life", 0.15) }
    }
}

enemy "Tomb Boss Anchor" {
    conditional_effect(invincible, true)
    drop_portal_on_death("Realm Portal", 100)
    state Idle {
        on entities_not_exists(300, "Tomb Support", "Tomb Attacker", "Tomb Defender", "Active Sarcophagus", "Tomb Defender Statue", "Tomb Support Statue", "Tomb Attacker Statue") -> Death
    }
    state Death {
        suicide()
    }
}

