enemy "Tomb Defender Statue" {
    conditional_effect(invulnerable)
    on entity_not_exists("Inactive Sarcophagus", 1000) -> checkActive
    on entity_not_exists("Active Sarcophagus", 1000) -> checkInactive
    state checkActive {
        conditional_effect(invulnerable)
        on entity_not_exists("Active Sarcophagus", 1000) -> ItsGoTime
    }
    state checkInactive {
        conditional_effect(invulnerable)
        on entity_not_exists("Inactive Sarcophagus", 1000) -> ItsGoTime
    }
    state ItsGoTime {
        transform("Tomb Defender")
    }
}

enemy "Tomb Support Statue" {
    conditional_effect(invulnerable)
    on entity_not_exists("Inactive Sarcophagus", 1000) -> checkActive
    on entity_not_exists("Active Sarcophagus", 1000) -> checkInactive
    state checkActive {
        conditional_effect(invulnerable)
        on entity_not_exists("Active Sarcophagus", 1000) -> ItsGoTime
    }
    state checkInactive {
        conditional_effect(invulnerable)
        on entity_not_exists("Inactive Sarcophagus", 1000) -> ItsGoTime
    }
    state ItsGoTime {
        transform("Tomb Support")
    }
}

enemy "Tomb Attacker Statue" {
    conditional_effect(invulnerable)
    on entity_not_exists("Inactive Sarcophagus", 1000) -> checkActive
    on entity_not_exists("Active Sarcophagus", 1000) -> checkInactive
    state checkActive {
