enemy "Tomb Defender" {
    state idle {
        taunt(true, "THIS WILL NOW BE YOUR TOMB!")
        conditional_effect(armored)
        orbit(0.6, 5, target: "Tomb Boss Anchor", radius_variance: 0.5)
        on hp_below(0.989) -> weakning
    }
    state weakning {
        orbit(0.6, 5, target: "Tomb Boss Anchor", radius_variance: 0.5)
        conditional_effect(armored)
        taunt(true, "Impudence! I am an Immortal, I needn't waste time on you!")
        shoot(50, 20, projectile: 3, cooldown: 6000)
        state blue_shield_1 {
            conditional_effect(invulnerable)
            on timed(3000, "unset blue shield 1") -> unset_blue_shield_1
        }
        state unset_blue_shield_1 {
        }
        on hp_below(0.979) -> active
    }
    state active {
        orbit(0.7, 5, target: "Tomb Boss Anchor", radius_variance: 0.5)
        conditional_effect(armored)
        shoot(50, 8, 45, 2, 0, 0, cooldown: 1000)
        shoot(50, 3, 120, 1, 0, 0, cooldown: 5000)
        shoot(50, 5, 72, 0, 0, 0, cooldown: 5000)
        on hp_below(0.7) -> boomerang
    }
    state boomerang {
        conditional_effect(armored)
        orbit(0.6, 3, target: "Tomb Boss Anchor", radius_variance: 0.5)
        taunt(true, "Nut, disable our foes!")
        shoot(50, 1, projectile: 0, cooldown: 3000)
        shoot(50, 8, projectile: 2, cooldown: 1000)
        shoot(50, 3, 15, 1, cooldown: 3000)
        shoot(50, 2, 90, 1, cooldown: 3000)
        state blue_shield_2 {
            conditional_effect(invulnerable)
            on timed(3000, "unset blue shield 2") -> unset_blue_shield_2
        }
        state unset_blue_shield_2 {
        }
        on hp_below(0.55, "double shot") -> double_shot
    }
    state double_shot {
        taunt(true, "Geb, eradicate these cretins from our tomb!")
        orbit(0.7, 5, target: "Tomb Boss Anchor", radius_variance: 0.5)
        shoot(50, 8, projectile: 2, cooldown: 1000)
        shoot(50, 2, 10, 0, cooldown: 3000)
        shoot(50, 4, 15, 1, cooldown: 3000)
        shoot(50, 2, 90, 1, cooldown: 3000)
        on hp_below(0.4) -> artifacts
    }
    state artifacts {
        conditional_effect(armored)
        taunt(true, "Nut, let them wish they were dead!")
        orbit(0.6, 7, target: "Tomb Boss Anchor", radius_variance: 0.5)
        shoot(50, 8, projectile: 2, cooldown: 1000)
        shoot(50, 2, 10, 0, cooldown: 3000)
        shoot(50, 4, 15, 1, cooldown: 3000)
        shoot(50, 2, 90, 1, cooldown: 3000)
        spawn("Pyramid Artifact 1", 1, 0)
        spawn("Pyramid Artifact 2", 1, 0)
        state blue_shield_3 {
            conditional_effect(invulnerable)
            on timed(3000, "unset blue shield 3") -> unset_blue_shield_3
        }
        state unset_blue_shield_3 {
        }
        on hp_below(0.25, "artifacts 2") -> artifacts_2
    }
    state artifacts_2 {
        conditional_effect(armored)
        taunt(true, "My artifacts shall prove my wall of defense is impenetrable!")
        orbit(0.6, 7, target: "Tomb Boss Anchor", radius_variance: 0.5)
        shoot(50, 8, projectile: 2, cooldown: 1000)
        shoot(50, 3, 10, 0, cooldown: 3000)
        shoot(50, 5, 15, 1, cooldown: 3000)
        shoot(50, 2, 80, 1, cooldown: 3000)
        shoot(50, 2, 90, 1, cooldown: 3000)
        spawn("Pyramid Artifact 1", 2, 0)
        state blue_shield_4 {
            conditional_effect(invulnerable)
            on timed(3000, "unset blue shield 4") -> unset_blue_shield_4
        }
        state unset_blue_shield_4 {
        }
        on hp_below(0.06) -> rage
    }
    state rage {
        conditional_effect(armored)
        taunt(true, "The end of your path is here!")
        follow(0.6, range: 1, duration: 5000, cooldown: 0)
        flash(268369920, 1, 9000001)
        shoot(50, 10, 10, 4, cooldown: 750, cooldown_offset: 750)
        shoot(50, 5, 10, 4, angle_offset: 180, cooldown: 500, cooldown_offset: 500)
        shoot(50, 1, projectile: 0, cooldown: 1000)
        shoot(50, 3, 15, 1, cooldown: 2000)
        shoot(50, 2, 90, 1, cooldown: 2000)
        spawn("Pyramid Artifact 1", 1, 0)
        spawn("Pyramid Artifact 2", 1, 0)
        spawn("Pyramid Artifact 3", 1, 0)
        state blue_shield_5 {
            conditional_effect(invulnerable)
            on timed(3000, "unset blue shield 5") -> unset_blue_shield_5
        }
        state unset_blue_shield_5 {
        }
    }
    loot {
        threshold(0.01) { item("Potion of Life", 1) item("Ring of the Pyramid", 0.04) item("Tome of Holy Protection", 0.01) item("Wine Cellar Incantation", 0.05) }
    }
}

