enemy "Davy Jones" {
    state Floating {
        change_size(100, 100)
        set_alt_texture(1)
        set_alt_texture(3)
        wander(0.2)
        shoot(10, 5, 10, 0, cooldown: 2000)
        shoot(10, 1, 10, 1, cooldown: 4000)
        on entity_not_exists("Ghost Lanturn Off", 10) -> Vunerable
        conditional_effect(invulnerable)
    }
    state CheckOffLanterns {
        set_alt_texture(2)
        stay_close_to_spawn(0.1, 3)
        conditional_effect(invulnerable)
        on entity_not_exists("Ghost Lanturn Off", 10) -> Vunerable
    }
    state Vunerable {
        set_alt_texture(2)
        stay_close_to_spawn(0.1, 0)
        on timed(2500) -> deactivate
    }
    state deactivate {
        set_alt_texture(2)
        stay_close_to_spawn(0.1, 0)
        on entity_not_exists("Ghost Lanturn On", 10) -> Floating
    }
    loot {
        threshold(0.05) {  }
        threshold(0.15) { tier(3, ring, 0.2) tier(7, armor, 0.2) tier(8, weapon, 0.2) tier(4, ability, 0.1) tier(8, armor, 0.1) tier(4, ring, 0.05) tier(9, armor, 0.03) tier(5, ability, 0.03) tier(9, weapon, 0.03) tier(10, armor, 0.02) tier(10, weapon, 0.02) tier(11, armor, 0.01) tier(11, weapon, 0.01) tier(5, ring, 0.01) item("Spirit Dagger", 0.015) item("ZSaber", 0.005) item("Spectral Cloth Armor", 0.013) item("Ghostly Prism", 0.01) item("Captain's Ring", 0.03) item("Potion of Wisdom", 1) item("Potion of Attack", 0.5) item("Ruby Gemstone", 0.02) item("Golden Chalice", 0.025) item("Pearl Necklace", 0.035) }
    }
}

enemy "Ghost Lanturn Off" {
    state default {
        conditional_effect(invincible)
        on entity_not_exists("Yellow Key", 9999) -> gogogo
    }
    state gogogo {
        transform_on_death("Ghost Lanturn On")
    }
}

enemy "Lost Soul" {
    state Default {
        prioritize() {
            orbit(0.3, 3, 20, "Ghost of Roger")
            wander(0.1)
        }
        on player_within(4) -> Default1
    }
    state Default1 {
        charge(0.5, 8, cooldown: 2000)
        on timed(2200) -> Blammo
    }
    state Blammo {
        shoot(10, count: 6, projectile: 0, cooldown: 2000)
        suicide()
    }
}

enemy "Ghost of Roger" {
    state spawn {
        spawn("Lost Soul", 3, 1, 5000)
        on timed(100) -> Attack
    }
    state Attack {
        shoot(13, 1, 0, 0, cooldown: 10)
        on timed(20) -> Attack2
    }
    state Attack2 {
        shoot(13, 1, 0, 0, cooldown: 10)
        on timed(20) -> Attack3
    }
    state Attack3 {
        shoot(13, 1, 0, 0, cooldown: 10)
        on timed(20) -> Wait
    }
    state Wait {
        on timed(1000) -> Attack
    }
}

enemy "Purple Key" {
    remove_object_on_death("GhostShip PurpleDoor Lf", 99)
    remove_object_on_death("GhostShip PurpleDoor Rt", 99)
    state Idle {
        on player_within(1) -> Cycle
    }
    state Cycle {
        taunt(true, "Purple Key has been found!")
        suicide()
    }
}

