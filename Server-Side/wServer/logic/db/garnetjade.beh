enemy "Encounter Altar" {
    state Wait {
        conditional_effect(invincible, true)
        on player_within(6, "ActivateG&J") -> ActivateG_J
    }
    state ActivateG_J {
        order(100, "Garnet Statue", "Activate")
        order(100, "Jade Statue", "Activate")
        on timed(170, "IsG&JDead?") -> IsG_JDead_
    }
    state IsG_JDead_ {
        on entities_not_exists(50, "Garnet Statue", "Jade Statue") -> DropPortal
    }
    state DropPortal {
        suicide()
    }
}

