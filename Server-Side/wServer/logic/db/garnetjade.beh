enemy "Corrupted Sprite" {
    state One {
        follow(0.4, range: 1, duration: 5000, cooldown: 0)
        shoot(10, count: 1, predictive: 1, projectile: 0, cooldown: 99999)
        shoot(10, count: 1, predictive: 1, projectile: 0, cooldown: 99999, cooldown_offset: 400)
        shoot(10, count: 2, predictive: 1, shoot_angle: 25, projectile: 0, cooldown: 99999, cooldown_offset: 1200)
        shoot(10, count: 2, predictive: 1, shoot_angle: 25, projectile: 0, cooldown: 99999, cooldown_offset: 1600)
        shoot(10, count: 8, predictive: 1, shoot_angle: 30, projectile: 0, cooldown: 99999, cooldown_offset: 2300)
        shoot(10, count: 8, predictive: 1, shoot_angle: 30, projectile: 0, cooldown: 99999, cooldown_offset: 2800)
        shoot(10, count: 2, predictive: 1, shoot_angle: 25, projectile: 0, cooldown: 99999, cooldown_offset: 3200)
        shoot(10, count: 2, predictive: 1, shoot_angle: 25, projectile: 0, cooldown: 99999, cooldown_offset: 3500)
        shoot(10, count: 1, predictive: 1, projectile: 0, cooldown: 99999, cooldown_offset: 4000)
        shoot(10, count: 1, predictive: 1, projectile: 0, cooldown: 99999, cooldown_offset: 4400)
        on timed(10000) -> KYS
    }
    state KYS {
        suicide()
    }
}

