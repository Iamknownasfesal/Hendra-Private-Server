enemy "Deathmage" {
    state Waiting {
        prioritize() {
            stay_close_to_spawn(0.8, 5)
            wander(0.4)
        }
        order(10, "Skeleton", "Protect")
        order(10, "Skeleton Swordsman", "Protect")
        order(10, "Skeleton Veteran", "Protect")
        order(10, "Skeleton Mage", "Protect")
        on player_within(15) -> Attacking
    }
    state Attacking {
        taunt(0.2, 2000, "{PLAYER}, you will soon be my undead slave!", "My skeletons will make short work of you.", "You will never leave this graveyard alive!")
        prioritize() {
            stay_close_to_spawn(0.8, 5)
            follow(0.8, range: 8)
            wander(0.4)
        }
        shoot(10, count: 3, shoot_angle: 15, predictive: 1)
        state Circling {
            orbit(0.8, 5)
            order(10, "Skeleton", "Circling")
            order(10, "Skeleton Swordsman", "Circling")
            order(10, "Skeleton Veteran", "Circling")
            order(10, "Skeleton Mage", "Circling")
            on timed(2000) -> Engaging
        }
        state Engaging {
            order(10, "Skeleton", "Engaging")
            order(10, "Skeleton Swordsman", "Engaging")
            order(10, "Skeleton Veteran", "Engaging")
            order(10, "Skeleton Mage", "Engaging")
            on timed(2000) -> Circling
        }
        on no_player_within(30) -> Waiting
    }
    spawn("Skeleton", max_children: 4, cooldown: 8000, gives_no_xp: false)
    spawn("Skeleton Swordsman", max_children: 2, cooldown: 8000, gives_no_xp: false)
    spawn("Skeleton Veteran", max_children: 1, cooldown: 8000, gives_no_xp: false)
    spawn("Skeleton Mage", max_children: 1, cooldown: 8000, gives_no_xp: false)
}

