enemy "Skeleton" {
    shoot(3)
    state Default {
        prioritize() {
            follow(1, range: 1)
            wander(0.4)
        }
    }
    state Protect {
        prioritize() {
            protect(1, "Deathmage")
            wander(0.4)
        }
        on entity_not_exists("Deathmage", 10) -> Default
    }
    state Circling {
        prioritize() {
            orbit(1, 10)
            wander(0.4)
        }
        on entity_not_exists("Deathmage", 10) -> Default
    }
    state Engaging {
        prioritize() {
            follow(1, acquire_range: 15, range: 1)
            wander(0.4)
        }
        on entity_not_exists("Deathmage", 10) -> Default
    }
    loot {
        item("Long Sword", 0.02)
        item("Dirk", 0.02)
    }
}

