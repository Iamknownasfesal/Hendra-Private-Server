        shoot(8, projectile: 0, count: 2, shoot_angle: 24, cooldown: 100000, cooldown_offset: 2200)
        shoot(8, projectile: 0, count: 1, predictive: 0.2, cooldown: 100000, cooldown_offset: 2800)
        shoot(8, projectile: 0, count: 2, shoot_angle: 16, cooldown: 100000, cooldown_offset: 3200)
        shoot(8, projectile: 0, count: 1, predictive: 0.1, cooldown: 100000, cooldown_offset: 3800)
        prioritize() {
            stay_above(0.6, 60)
            wander(0.6)
        }
        on timed(5000) -> flame_ring
    }
    state flame_ring {
        shoot(7, projectile: 1, count: 30, shoot_angle: 12, cooldown: 400, cooldown_offset: 600)
        prioritize() {
            stay_above(0.6, 60)
            follow(0.6, acquire_range: 9, range: 1)
            wander(0.6)
        }
        on timed(3500) -> pause
    }
    state pause {
        prioritize() {
            stay_above(0.6, 60)
            wander(0.6)
        }
        on timed(1000) -> idle
    }
    loot {
        tier(4, weapon, 0.14)
        tier(5, weapon, 0.05)
        tier(5, armor, 0.19)
        tier(6, armor, 0.02)
        tier(2, ring, 0.07)
        tier(2, ability, 0.27)
        item("Health Potion", 0.12)
        item("Magic Potion", 0.1)
    }
}

