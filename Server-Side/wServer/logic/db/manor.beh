enemy "Lord Ruthven" {
    realm_portal_drop()
    state default {
        on player_within(8) -> spooksters
    }
    state spooksters {
        wander(0.2)
        shoot(10, count: 5, shoot_angle: 2, projectile: 0, cooldown: 900)
        on timed(6000) -> spooksters2
    }
    state spooksters2 {
        wander(0.15)
        shoot(8.4, count: 40, projectile: 1, cooldown: 2750)
        shoot(10, count: 5, shoot_angle: 2, projectile: 0, cooldown: 900)
        on timed(4000) -> spooksters3
    }
    state spooksters3 {
        heal_self(cooldown: 1250)
        shoot(8.4, count: 40, projectile: 1, cooldown: 2750)
        on timed(4000) -> spooksters
    }
    loot {
        threshold(0.05) {  }
        threshold(0.025) { tier(9, weapon, 0.1) tier(4, ability, 0.1) tier(9, armor, 0.1) tier(3, ring, 0.05) tier(10, armor, 0.05) tier(10, weapon, 0.05) tier(4, ring, 0.025) item("Potion of Attack", 1) item("Holy Water", 0.5) item("Death Tarot Card", 0.05) item("Chasuble of Holy Light", 0.01) item("St. Abraham's Wand", 0.01) item("Unholy Quiver", 0.001) item("Unholy Wand", 0.001) item("Tome of Purification", 0.001) item("Ring of Divine Faith", 0.01) item("Bone Dagger", 0.08) }
    }
}

